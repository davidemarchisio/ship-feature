#!/usr/bin/env bash
# ship-feature — a small helper for the ship-feature workflow (see WORKFLOW.md).
#
# v1 commands:
#   ship-feature preflight   Assert the working copy is set up for step 4 (worktree, feature
#                            branch off origin/HEAD, excluded marker, ancestry, and a committed
#                            .githooks/pre-push that git runs on push). Non-zero on failure.
#   ship-feature relay [..]  Transparent pass-through to `pr-review-relay`: forwards all args, preserves
#                            stdout and the EXACT exit code, and prints (on stderr) a one-line reminder of
#                            what each code means for the workflow.
#   ship-feature plan-review [<file>] [--reviewers a,b,c] [--sequential]
#                            Step 2: fan an implementation PLAN (a file, stdin, or ./plan.md) out to a
#                            panel of agents for a read-only review; prints each review. Defaults the
#                            panel to SHIP_FEATURE_PLAN_REVIEWERS, then SHIP_FEATURE_REVIEWERS. The
#                            panel runs in PARALLEL by default: reviewers are independent, and running
#                            them one after another multiplies the per-reviewer timeout by the panel
#                            size (a 4-seat panel at the per-reviewer timeout each could sit for many
#                            minutes before
#                            printing a verdict). --sequential restores one-at-a-time, streaming each
#                            review as it lands, for when you want to watch a single reviewer work or
#                            to keep concurrent agent load down. Exit 0 clean, 3 not-clean, 1 usage
#                            error.
#   ship-feature plan-consensus <plan-file> --autonomous
#                            EXPERIMENTAL. Gate 1 without a human: the full PLAN_REVIEWERS panel must all
#                            return `VERDICT: clean` in one round (cap 6 rounds, 9 attempts). Needs
#                            SHIP_FEATURE_AUTONOMOUS=1. Exit 0 consensus, 2 revise, 3 seat failed, 5 stop, 7 refused.
#   ship-feature relay --autonomous [..]
#                            EXPERIMENTAL. Full-panel rounds only, verdict file at a computed path, one round
#                            counter per PR (cap 6). Exit 4 = stop and notify.
#   ship-feature merge-gate <pr> --autonomous [--merge]
#                            EXPERIMENTAL. Gate 2 without a human: eight checks, then one pinned
#                            `gh pr merge --merge --match-head-commit`. Exit 6 stop, 7 refused, 8 audit not posted.
#   ship-feature help        This message.
#
# The workflow itself lives in WORKFLOW.md; this tool does not drive it. State/resume is intentionally
# NOT in v1. Bash 3.2-safe (no associative arrays, no ${x^}); no jq dependency.
set -uo pipefail

die()  { echo "✖ $*" >&2; exit 1; }
warn() { echo "  ! $*" >&2; }
ok()   { echo "  ✓ $*"; }

# Kill a process AND its whole descendant tree, children first. Walking by PPID
# (`pgrep -P`) rather than by process group is deliberate: `timeout` puts its child in
# a NEW process group, so a group-kill of the backgrounded job would miss the reviewer
# two levels down (subshell → $() → timeout → agent). Children-before-parent so a killed
# parent can't reparent its children to init before we've found them. pgrep is present on
# Linux and macOS. Best-effort (a process forking mid-sweep can still slip), which is why
# each reviewer also runs under a `timeout`.
kill_tree() {
  local pid="$1" child
  for child in $(pgrep -P "$pid" 2>/dev/null); do kill_tree "$child"; done
  kill -TERM "$pid" 2>/dev/null || true
}

# Stale spellings of the `glm` seat that were seen while loading config, recorded here and
# reported by cmd_plan_review. GLOBAL on purpose: every variable inside the two loaders is
# `local`, so a recorder declared there would be gone by the time anything could print it.
#
# Recorded, never honoured. A config that names the seat by its old name must not quietly work —
# that silent fallback is the exact defect this rename exists to remove, and honouring the old
# name here would rebuild it one level down.
#
# Reported by `plan-review` ONLY, not by `relay` or `preflight`. Both of those also call
# load_config, and a deprecation notice about a plan-review seat has no business printing on a
# cross-review run.
SF_DEPRECATED_SEAT_KEYS=""
sf_note_deprecated() {
  case " $SF_DEPRECATED_SEAT_KEYS " in *" $1 "*) return 0;; esac   # once per key, not once per line
  SF_DEPRECATED_SEAT_KEYS="${SF_DEPRECATED_SEAT_KEYS:+$SF_DEPRECATED_SEAT_KEYS }$1"
}

# Where WORKFLOW.md §1 says plans live. One canonical path, matching install.sh
# by construction — a reviewer found the alternative: deriving it from
# SHIP_FEATURE_CONFIG made the two disagree for anyone with a custom config, and
# `SHIP_FEATURE_CONFIG=/dev/null` (the ordinary way to say "no config") resolved
# the plans directory to `/dev`. That variable names a config FILE to read, not a
# relocation of the install. `SHIP_FEATURE_PLANS_DIR` is the explicit override.
SF_PLANS_DIR="${SHIP_FEATURE_PLANS_DIR:-$HOME/.config/ship-feature/plans}"

# Created on demand, not only by the installer. An existing install that updates
# the repository gets the new workflow — which tells its agent to write a plan
# here — while the directory still does not exist, and the first plan write
# fails. Best effort: this is a diagnostic path, not a reason to refuse a
# command. Mode 0700 for the same reason the installer sets it: a plan describes
# an unreleased change in a private repository. A symlink is left alone.
sf_ensure_plans_dir() {
  [ -e "$SF_PLANS_DIR" ] && return 0
  mkdir -p "$SF_PLANS_DIR" 2>/dev/null || return 0
  chmod 700 "$SF_PLANS_DIR" 2>/dev/null || true
}

# Load ~/.config/ship-feature/config as plain KEY=value lines — NEVER shell-`source`d, and only known
# SHIP_FEATURE_* keys are honored. Environment variables win over the file.
load_config() {
  local cfg="${SHIP_FEATURE_CONFIG:-$HOME/.config/ship-feature/config}" key val
  # The shared pins are read whether or not THIS file exists — a machine can perfectly well have
  # pr-review-relay configured and no ship-feature config at all, and the early return below
  # would otherwise skip the fallback entirely. Found by the test that asserts the shared file is
  # read, running with SHIP_FEATURE_CONFIG=/dev/null.
  # The ENVIRONMENT spelling, checked BEFORE the early return below. Neither loader ever reads a
  # variable — they parse files — so an env-only stale key would otherwise be seen by nothing at
  # all, and on a machine with no ship-feature config this function returns two lines down.
  #
  # ${VAR+x}, i.e. IS IT SET, not ${VAR:-}, i.e. is it non-empty — the opposite of the convention
  # every model pin in this file uses. Deliberate: those keys ask "was a model configured", where
  # empty means no. This one asks "does a dead name still exist in your environment", and
  # `export KIMI3_REVIEW_MODEL=` is exactly that — a line in a shell profile that will keep
  # looking like configuration to whoever reads it next. It never pinned anything, so nothing
  # breaks either way; it is reported so it can be deleted rather than puzzled over.
  [ -n "${KIMI3_REVIEW_MODEL+x}" ] && sf_note_deprecated env:KIMI3_REVIEW_MODEL
  # Same for the grok seat's old name (`grok45high`, renamed to `grok` in 2026-09). Here, before
  # the early return, for the reason above: with no ship-feature config this function returns on
  # the next line, and a probe inside the loop would never see a stale export.
  [ -n "${GROK45HIGH_REVIEW_MODEL+x}" ] && sf_note_deprecated env:GROK45HIGH_REVIEW_MODEL
  [ -f "$cfg" ] || { load_shared_panel_config; return 0; }
  # `|| [ -n "$key$val" ]` so a file with NO FINAL NEWLINE does not lose its last line. Without
  # it, `read` returns non-zero on that line and the loop exits before the case runs —
  # pr-review-relay's parser reads it, so the SAME file would select different models in the two
  # tools, which is the drift this whole change exists to remove.
  while IFS='=' read -r key val || [ -n "$key$val" ]; do
    case "$key" in ''|\#*) continue;; esac
    key="$(printf '%s' "$key" | tr -d '[:space:]')"
    val="${val%%[[:space:]]#*}"                                                   # strip an inline "# comment"
    val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"     # trim surrounding space
    case "$key" in
      # Use ${VAR+x} (is it DEFINED?) not ${VAR:-} (is it non-empty?), so an explicitly empty environment
      # value (e.g. SHIP_FEATURE_REVIEWERS=) wins over the config file and disables it.
      SHIP_FEATURE_WORKTREE_ROOT) [ -n "${SHIP_FEATURE_WORKTREE_ROOT+x}" ] || SHIP_FEATURE_WORKTREE_ROOT="$val" ;;
      SHIP_FEATURE_EXCLUDE_MARKER) [ -n "${SHIP_FEATURE_EXCLUDE_MARKER+x}" ] || SHIP_FEATURE_EXCLUDE_MARKER="$val" ;;
      SHIP_FEATURE_DENYLIST) [ -n "${SHIP_FEATURE_DENYLIST+x}" ] || SHIP_FEATURE_DENYLIST="$val" ;;
      SHIP_FEATURE_REVIEWERS) [ -n "${SHIP_FEATURE_REVIEWERS+x}" ] || SHIP_FEATURE_REVIEWERS="$val" ;;
      SHIP_FEATURE_PLAN_REVIEWERS) [ -n "${SHIP_FEATURE_PLAN_REVIEWERS+x}" ] || SHIP_FEATURE_PLAN_REVIEWERS="$val" ;;
      # NON-EMPTY (${VAR:-}), NOT ${VAR+x} like the keys above — and the difference matters.
      # Those keys treat an explicitly empty value as a deliberate "disable"; a timeout has no such
      # meaning, an empty one is just absent. With ${VAR+x} an exported `SHIP_FEATURE_PLAN_TIMEOUT=`
      # would block THIS file while load_shared_panel_config, which tests non-empty, still filled
      # from the shared AGENT_TIMEOUT — silently deleting this rung of the ladder.
      #
      # It was environment-only until now, alone among the SHIP_FEATURE_* keys, which is why writing
      # it into this file did nothing at all. Demonstrated the hard way: the line was added here and
      # the next plan review still ran on the old default.
      # `export -n` for the same reason load_shared_panel_config does it, and the first draft of
      # this change fixed that site and missed this one. A plain assignment does NOT clear an
      # inherited export attribute, so a caller that exported the name — even empty — would have
      # THIS file's value cross into the pr-review-relay child. Reproduced before fixing:
      # `export SHIP_FEATURE_PLAN_TIMEOUT=` plus `SHIP_FEATURE_PLAN_TIMEOUT=420` in this file put
      # `SF=420` in the child's environment. plan-review's budget is plan-review's alone.
      SHIP_FEATURE_PLAN_TIMEOUT)
        if [ -z "${SHIP_FEATURE_PLAN_TIMEOUT:-}" ]; then
          export -n SHIP_FEATURE_PLAN_TIMEOUT 2>/dev/null || true
          SHIP_FEATURE_PLAN_TIMEOUT="$val"
        fi ;;
      # The model pins. Same precedence as the keys above — the environment wins, the file
      # fills in.
      #
      # These are the only keys here NOT named SHIP_FEATURE_*, and the names are not ours to
      # change: CURSOR_REVIEW_MODEL and PR_RELAY_OPENCODE_MODEL are read by `pr-review-relay`
      # as well, and one setting should configure both tools. That is also why they are
      # EXPORTED rather than merely assigned — `relay` runs pr-review-relay as a CHILD process,
      # and a plain shell variable does not cross that boundary.
      #
      # They were environment-only until now, which meant the panel was described in two
      # places: who sits on it here, what they actually run in ~/.zshrc. One file says both
      # now, so a seat and its model cannot drift apart — and a run with no shell profile (a
      # cron job, a fresh machine) gets the same panel as an interactive one instead of
      # silently falling back to a bundled default.
      #
      # NON-EMPTY (${VAR:-}), unlike the keys above: an explicitly empty SHIP_FEATURE_REVIEWERS
      # means "disable", which is a real thing to want, but an empty model pin means nothing at
      # all. Treating it as "defined" would let `CURSOR_REVIEW_MODEL=` block both this file and
      # the shared one, leaving ship-feature on its built-in default while pr-review-relay used
      # the configured value — the same inputs, two different models.
      GLM_REVIEW_MODEL) [ -n "${GLM_REVIEW_MODEL:-}" ] || export GLM_REVIEW_MODEL="$val" ;;
      # The seat's old name. Recorded and DROPPED, never assigned: `load_config` has no `*)` arm,
      # so without this line the key would fall through in silence and the seat would run the
      # built-in default while the file plainly named a model — the same silent drop that
      # renaming this seat was meant to end.
      KIMI3_REVIEW_MODEL) sf_note_deprecated file:KIMI3_REVIEW_MODEL ;;
      CURSOR_REVIEW_MODEL) [ -n "${CURSOR_REVIEW_MODEL:-}" ] || export CURSOR_REVIEW_MODEL="$val" ;;
      # The grok seat's old key. Recorded and DROPPED, like KIMI3_REVIEW_MODEL above: the seat is
      # `grok` now and takes MODEL_grok / EFFORT_grok from the shared panel config.
      GROK45HIGH_REVIEW_MODEL) sf_note_deprecated file:GROK45HIGH_REVIEW_MODEL ;;
      # The claude, codex and grok pins are read from the SHARED panel config and the environment
      # only — never from this file. They are the relay's own names, one global file is the point,
      # and a third place is how they drifted in the first place. Recorded so the value is
      # reported rather than dropped in silence (this loop has no `*)` arm).
      CLAUDE_REVIEW_MODEL|CLAUDE_REVIEW_EFFORT|CODEX_REVIEW_MODEL|CODEX_REVIEW_EFFORT|GROK_REVIEW_MODEL|GROK_REVIEW_EFFORT)
        sf_note_deprecated "file:$key" ;;
      PR_RELAY_OPENCODE_MODEL) [ -n "${PR_RELAY_OPENCODE_MODEL:-}" ] || export PR_RELAY_OPENCODE_MODEL="$val" ;;
      # The gemini seat's pins live in the SHIP_FEATURE_* namespace, NOT the vendor-shaped
      # <SEAT>_REVIEW_MODEL shape of the pins above, and deliberately so. Those names are
      # vendor-shaped for exactly one reason: `pr-review-relay` reads them from this same file.
      # The relay has no gemini seat — its `antigravity` seat runs the `agy` binary and takes
      # AGY_REVIEW_MODEL — so a vendor-shaped name here would buy nothing and would invite the two
      # to be pinned as if they were one seat. They are not: different binaries, different accepted
      # model ids.
      # NON-EMPTY (${VAR:-}) like the model pins above, not ${VAR+x}: an empty model pin means
      # nothing at all, so it must not count as "defined" and block the shared file.
      SHIP_FEATURE_GEMINI_MODEL) [ -n "${SHIP_FEATURE_GEMINI_MODEL:-}" ] || SHIP_FEATURE_GEMINI_MODEL="$val" ;;
      # The gemini-cli versions whose TOOL REGISTRY this seat has actually been audited against
      # (see the version gate in plan_review_with). Non-empty semantics for the same reason: an
      # empty list is not a way to say "allow everything", it is just absent, and the gate stays
      # closed on the built-in default.
      SHIP_FEATURE_GEMINI_TESTED_VERSIONS) [ -n "${SHIP_FEATURE_GEMINI_TESTED_VERSIONS:-}" ] || SHIP_FEATURE_GEMINI_TESTED_VERSIONS="$val" ;;
    esac
  done < "$cfg"

  load_shared_panel_config
}

# The SHARED PANEL config: pr-review-relay's own file, read here as the LAST fallback — who sits on
# the panel (REVIEWERS, PLAN_REVIEWERS), what each seat runs (MODEL_*), and how long each gets
# (AGENT_TIMEOUT).
#
# Renamed from load_shared_model_pins: it stopped being only about model pins when REVIEWERS and
# PLAN_REVIEWERS moved here, and a name that lies is how the next key ends up in a fourth place.
#
# Both tools review with the same seats on the same accounts, so which model a seat runs is a
# property of the machine, not of the tool that happens to be invoking it. pr-review-relay
# already keeps that in one place, keyed by SEAT name, and it has carried this seat's key since
# 2026-08-14 with a comment saying it would take effect once ship-feature learned to read this
# file. This is that. (The key was `MODEL_kimi3` until the seat was renamed; see the deprecated
# arm in the parser below.)
#
# Keyed by seat means keyed by seat. `grok` is ONE seat in both tools since 2026-09 (plan-review
# called it `grok45high` and ran it at a hardcoded high effort until then), so `MODEL_grok` /
# `EFFORT_grok` pin it for the plan review and the PR review alike. The same holds for `claude`
# and `codex`, whose plan-review calls used to take no pin at all.
#
# Without it the pin lives in two files at once and they drift: whichever one you edit, the
# other keeps its old value and nothing complains, because both are valid config.
#
# Precedence, lowest last: environment > ship-feature's own config > this file. It is called at
# the END of load_config for exactly that reason — by the time it runs, every key it touches is
# already set if either higher source provided one.
#
# `MODEL_opencode` is deliberately NOT mapped. That seat belongs to pr-review-relay, which reads
# this file itself; exporting PR_RELAY_OPENCODE_MODEL from here would push an environment value
# on top of the relay's own config and beat it, which is the opposite of consolidating.
load_shared_panel_config() {
  # ${HOME:-}, not $HOME: under `set -u` an unset HOME aborts the whole command, and a caller
  # that sets both ship-feature paths explicitly has every right not to have one.
  local cfg="${PR_RELAY_CONFIG:-${HOME:-}/.config/pr-review-relay/config}" key val
  # LAST VALUE WINS within this file, as in pr-review-relay's own parser. Guarding only on "is it
  # set" would keep the FIRST of two `REVIEWERS=` lines here while the relay kept the last — a
  # valid file handing the two tools different panels, which is exactly what reading one file is
  # meant to prevent. These flags say "a HIGHER source already provided this", which is the thing
  # that must not be overwritten; a later line of this same file may.
  local from_env_glm=1 from_env_cursor=1 from_env_rev=1 from_env_plan=1 from_env_timeout=1
  local from_env_gemini=1
  local from_env_claude_m=1 from_env_claude_e=1 from_env_codex_m=1 from_env_codex_e=1 from_env_grok_m=1 from_env_grok_e=1
  # GLM_REVIEW_MODEL and nothing else. Arming this from the seat's OLD name would let a stale
  # KIMI3_REVIEW_MODEL left in a shell profile mark the pin as "already provided by a higher
  # source", so MODEL_glm in the shared file would be skipped — the silent drop this rename
  # exists to remove, rebuilt inside the fix for it.
  [ -n "${GLM_REVIEW_MODEL:-}" ] || from_env_glm=0
  [ -n "${CURSOR_REVIEW_MODEL:-}" ] || from_env_cursor=0
  # The relay's own environment names (pr-review-relay, lib-grok.sh), so one export pins the seat
  # in both tools. Each flag is armed from its NEW name only — never from GROK45HIGH_REVIEW_MODEL:
  # a stale export of the old name would otherwise mark MODEL_grok as "already provided" and the
  # shared pin would be skipped without a word, the trap the glm comment above describes.
  [ -n "${CLAUDE_REVIEW_MODEL:-}" ] || from_env_claude_m=0
  [ -n "${CLAUDE_REVIEW_EFFORT:-}" ] || from_env_claude_e=0
  [ -n "${CODEX_REVIEW_MODEL:-}" ] || from_env_codex_m=0
  [ -n "${CODEX_REVIEW_EFFORT:-}" ] || from_env_codex_e=0
  [ -n "${GROK_REVIEW_MODEL:-}" ] || from_env_grok_m=0
  [ -n "${GROK_REVIEW_EFFORT:-}" ] || from_env_grok_e=0
  [ -n "${SHIP_FEATURE_GEMINI_MODEL:-}" ] || from_env_gemini=0
  [ -n "${SHIP_FEATURE_REVIEWERS+x}" ] || from_env_rev=0
  [ -n "${SHIP_FEATURE_PLAN_REVIEWERS+x}" ] || from_env_plan=0
  # BOTH names, because both sit ABOVE this file on the ladder: SHIP_FEATURE_PLAN_TIMEOUT (rungs 1-2)
  # and PR_RELAY_AGENT_TIMEOUT (rung 3, the relay's own documented environment override). Guard on
  # only the first and a machine exporting the second gets that value in pr-review-relay and this
  # file's value here — the same inputs producing two different timeouts, which is the whole failure
  # this mapping exists to remove.
  [ -n "${SHIP_FEATURE_PLAN_TIMEOUT:-}" ] || [ -n "${PR_RELAY_AGENT_TIMEOUT:-}" ] || from_env_timeout=0
  [ -f "$cfg" ] || return 0
  while IFS='=' read -r key val || [ -n "$key$val" ]; do
    # Strip a leading UTF-8 BOM, as pr-review-relay's own parser does (lib-panel.sh). Without it
    # the first key of a BOM'd file reads as "\ufeffMODEL_glm" here and as "MODEL_glm" there:
    # one file, two different models, which is the whole failure this change removes.
    key="${key#$'\xef\xbb\xbf'}"
    case "$key" in ''|\#*) continue;; esac
    key="$(printf '%s' "$key" | tr -d '[:space:]')"
    val="${val%%[[:space:]]#*}"                                                   # strip an inline "# comment"
    val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"     # trim surrounding space
    # NON-EMPTY here, not merely DEFINED. The SHIP_FEATURE_* keys use ${VAR+x} so that an
    # explicitly empty value can DISABLE a setting on purpose; a model pin has no such meaning —
    # an empty one is just absent. With ${VAR+x}, `CURSOR_REVIEW_MODEL=` would block this file and
    # leave ship-feature on its built-in default while pr-review-relay used the shared value: the
    # same inputs, two different models.
    case "$key" in
      MODEL_glm)        [ "$from_env_glm" = 1 ] || export GLM_REVIEW_MODEL="$val" ;;
      # The seat's old key. Recorded and DROPPED — see the KIMI3_REVIEW_MODEL arm in load_config.
      # pr-review-relay still lists `kimi3` in its own PANEL_SEATS, so this key stays valid THERE
      # until that repo's follow-up lands; it just no longer configures anything here.
      MODEL_kimi3)      sf_note_deprecated shared:MODEL_kimi3 ;;
      MODEL_cursor)     [ "$from_env_cursor" = 1 ] || export CURSOR_REVIEW_MODEL="$val" ;;
      # The seat's old key, recorded and DROPPED like MODEL_kimi3 above. Honouring it as a fallback
      # would keep two keys alive for one seat, and the next edit would change only one of them.
      MODEL_grok45high) sf_note_deprecated shared:MODEL_grok45high ;;
      # claude, codex and grok. NOT exported, unlike the pins above, for the reason AGENT_TIMEOUT
      # gives below: pr-review-relay reads these same keys from this same file, and an environment
      # value pushed at the `relay` child would sit on top of its own config. They only have to
      # reach cmd_plan_review, in this process. `export -n` in the copying branch only, because a
      # plain assignment keeps an inherited export attribute — an exported EMPTY
      # `CODEX_REVIEW_MODEL=` would otherwise carry this file's value into the child.
      MODEL_claude)  [ "$from_env_claude_m" = 1 ] || { export -n CLAUDE_REVIEW_MODEL 2>/dev/null || true; CLAUDE_REVIEW_MODEL="$val"; } ;;
      EFFORT_claude) [ "$from_env_claude_e" = 1 ] || { export -n CLAUDE_REVIEW_EFFORT 2>/dev/null || true; CLAUDE_REVIEW_EFFORT="$val"; } ;;
      MODEL_codex)   [ "$from_env_codex_m" = 1 ] || { export -n CODEX_REVIEW_MODEL 2>/dev/null || true; CODEX_REVIEW_MODEL="$val"; } ;;
      EFFORT_codex)  [ "$from_env_codex_e" = 1 ] || { export -n CODEX_REVIEW_EFFORT 2>/dev/null || true; CODEX_REVIEW_EFFORT="$val"; } ;;
      MODEL_grok)    [ "$from_env_grok_m" = 1 ] || { export -n GROK_REVIEW_MODEL 2>/dev/null || true; GROK_REVIEW_MODEL="$val"; } ;;
      EFFORT_grok)   [ "$from_env_grok_e" = 1 ] || { export -n GROK_REVIEW_EFFORT 2>/dev/null || true; GROK_REVIEW_EFFORT="$val"; } ;;
      # `MODEL_gemini`, not `MODEL_antigravity`. The relay already maps MODEL_antigravity onto its
      # own agy seat; this one is the `gemini` binary. One key for two binaries would mean one of
      # them silently getting a model id its CLI does not accept. NOT exported, unlike the pins
      # above: nothing downstream reads it from the environment, and the isolated gemini child
      # should inherit no name we did not deliberately put there.
      MODEL_gemini)     [ "$from_env_gemini" = 1 ] || SHIP_FEATURE_GEMINI_MODEL="$val" ;;
      # WHO sits on the panel, from the same file for the same reason the models are. These two
      # were already duplicated across the two configs — identical today, free to drift tomorrow,
      # with nothing to notice it because both files are valid. A panel that differs between the
      # plan gate and the PR gate is the kind of difference you discover from a verdict.
      #
      # ${VAR+x} semantics here, unlike the model pins above: an explicitly empty
      # SHIP_FEATURE_REVIEWERS means "no injected quorum" on purpose, and that has to survive a
      # value in this file. (Captured in the flags above, before the loop.)
      #
      # NOT exported, unlike the model pins: the panel is passed to pr-review-relay as
      # `--reviewers` ARGUMENTS, in-process. The pins have to cross into the child, these do not.
      REVIEWERS)        [ "$from_env_rev" = 1 ] || SHIP_FEATURE_REVIEWERS="$val" ;;
      PLAN_REVIEWERS)   [ "$from_env_plan" = 1 ] || SHIP_FEATURE_PLAN_REVIEWERS="$val" ;;
      # HOW LONG a reviewer gets, from the same file for the same reason as WHO reviews and WHAT
      # they run. pr-review-relay reads this key already; ship-feature did not, so `AGENT_TIMEOUT`
      # in that file configured one tool of the two and every plan review silently kept the old
      # default. That is not a loud failure — a timed-out reviewer exits 3 and says so — but the
      # round returns no findings, and "no findings" reads exactly like a clean plan.
      #
      # Mapped onto SHIP_FEATURE_PLAN_TIMEOUT because that is the name the resolver at the top of
      # cmd_plan_review actually reads; mapping it onto PR_RELAY_AGENT_TIMEOUT would put an
      # environment value on top of the relay's own config, which MODEL_opencode below exists to
      # warn against.
      #
      # A PLAIN ASSIGNMENT, never `export` — unlike the model pins, which have to cross into the
      # pr-review-relay child. This must NOT: the relay reads this same file itself, and pushing a
      # value at it would beat its own config.
      #
      # `export -n` first, because a plain assignment does NOT clear an inherited export attribute.
      # A caller that exported the name (even empty) would otherwise have this resolved value cross
      # into the child anyway, quietly defeating the line above.
      AGENT_TIMEOUT)
        if [ "$from_env_timeout" != 1 ]; then
          export -n SHIP_FEATURE_PLAN_TIMEOUT 2>/dev/null || true
          SHIP_FEATURE_PLAN_TIMEOUT="$val"
        fi ;;
    esac
  done < "$cfg"
}

default_branch() {
  # refs/remotes/origin/HEAD -> the ref it points to, minus the "origin/" remote prefix.
  # Strip only the remote prefix (not everything up to the last /) so branch names containing '/'
  # (e.g. "release/main") survive.
  local ref
  ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) || return 1
  ref="${ref#refs/remotes/origin/}"
  printf '%s\n' "$ref"
}

# The repository's gate: a committed, executable `.githooks/pre-push` that git really runs on push.
# $1 = the worktree root. Prints nothing on success; on failure, the reason on stderr and non-zero.
# Never changes directory. The path is fixed, so the merge gate can check the commit under test and
# check 7 can treat it as sensitive. What the hook runs (tests, a linter, a formatter check) is not
# checked here: WORKFLOW.md step 4 makes that the agent's reading job.
sf_prepush_hook() {
  local top="$1" own line blob disk h
  local need="every repo shipped with ship-feature needs a committed .githooks/pre-push (mode 100755) that runs the tests, a linter and a formatter check, and 'git config core.hooksPath .githooks'. A repo without one adds it in its own PR first: commit the hook, then run preflight again"
  own="$top/.githooks/pre-push"
  if [ ! -e "$own" ] && [ ! -L "$own" ]; then echo "no pre-push hook: $own does not exist — $need." >&2; return 1; fi
  # -f, not -e: a directory named pre-push would pass -e and -x while git ran nothing.
  [ -f "$own" ] || { echo "$own is not a regular file — $need." >&2; return 1; }
  [ -x "$own" ] || { echo "$own is not executable — git skips a non-executable hook without a word. Run: chmod +x .githooks/pre-push" >&2; return 1; }
  # HEAD, not the index: preflight never passes on a hook that no commit holds.
  line="$(git -C "$top" ls-tree HEAD -- .githooks/pre-push 2>/dev/null)"
  [ -n "$line" ] || { echo ".githooks/pre-push is not committed on this branch (HEAD has no such file) — commit it, then run preflight again. $need." >&2; return 1; }
  case "$line" in
    "100755 blob "*) ;;
    "100644 blob "*) echo ".githooks/pre-push is committed as 100644, not 100755: a fresh clone checks it out without the executable bit, and git skips it. Run: git add --chmod=+x .githooks/pre-push (a plain git add records 100644 when core.filemode is false), then commit." >&2; return 1;;
    *) echo ".githooks/pre-push in HEAD is not a 100755 file (mode ${line%% *}); a symlink or a directory there is not accepted." >&2; return 1;;
  esac
  # The file on disk is the committed one. Blob ids, not `git diff`: diff skips a file marked
  # assume-unchanged or skip-worktree. And the index must not carry a different version either.
  blob="$(git -C "$top" rev-parse -q --verify "HEAD:.githooks/pre-push" 2>/dev/null)"
  disk="$(git -C "$top" hash-object -- "$own" 2>/dev/null)"
  if [ -z "$blob" ] || [ "$disk" != "$blob" ] || ! git -C "$top" diff --quiet --cached HEAD -- .githooks/pre-push 2>/dev/null; then
    echo ".githooks/pre-push differs from the committed one (on disk or staged) — commit the change, or restore it: git checkout HEAD -- .githooks/pre-push" >&2; return 1
  fi
  # Git runs that file. Ask git rather than copy its rules for core.hooksPath. A relative answer is
  # relative to $top (git -C does not move this process), so join it before comparing. -ef compares
  # device and inode after symlinks, so no path normalization is needed.
  h="$(git -C "$top" rev-parse --git-path hooks/pre-push 2>/dev/null)" || h=""
  case "$h" in /*) ;; *) h="$top/$h";; esac
  [ "$h" -ef "$own" ] || { echo "git runs $h on push, not this worktree's .githooks/pre-push — set the hook path once per clone: git config core.hooksPath .githooks" >&2; return 1; }
  return 0
}

cmd_preflight() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git working tree."
  load_config
  local worktree_root="${SHIP_FEATURE_WORKTREE_ROOT:-.claude/worktrees}"
  worktree_root="${worktree_root%/}"   # tolerate a trailing slash (else the "/root/" match breaks)
  # Default the excluded marker to the TOP component of the worktree root so they always correspond —
  # otherwise a custom root (e.g. ".worktrees") could pass while an unrelated ".claude/" is what's ignored.
  local exclude_marker="${SHIP_FEATURE_EXCLUDE_MARKER:-${worktree_root%%/*}/}"

  local def cur common_dir git_dir top
  def=$(default_branch) || die "cannot resolve origin/HEAD (the default branch). Run: git remote set-head origin -a"
  ok "default branch: $def"

  cur=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || die "cannot read current branch."
  [ "$cur" != "HEAD" ] || die "detached HEAD — check out a named feature branch before implementing."
  [ "$cur" != "$def" ] || die "you are on the default branch '$def' — create a feature branch/worktree first."
  ok "on feature branch: $cur"

  # Linked worktree: --git-dir and --git-common-dir are identical in the main tree and differ in a
  # linked worktree. (More robust than matching "/worktrees/" in the path, which a repo cloned under a
  # directory literally named "worktrees" would trip.)
  git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null)
  common_dir=$(git rev-parse --git-common-dir 2>/dev/null)
  # `CDPATH=` disables CDPATH lookups and the `./` prefix stops a value like `-` being read as an option.
  case "$common_dir" in /*) : ;; *) common_dir=$(CDPATH= cd "./$common_dir" 2>/dev/null && pwd) ;; esac
  if [ -n "$git_dir" ] && [ "$git_dir" != "$common_dir" ]; then
    ok "in a linked worktree"
  else
    die "not in a linked worktree — use 'git worktree add' (never work in the main tree)."
  fi

  # Worktree lives under the configured root (a workflow requirement, not just advice).
  top=$(git rev-parse --show-toplevel 2>/dev/null)
  case "$top" in
    *"/$worktree_root/"*) ok "worktree under $worktree_root/" ;;
    *) die "worktree is not under $worktree_root/ — create it there (or set SHIP_FEATURE_WORKTREE_ROOT)." ;;
  esac

  # The marker must actually be IGNORED — ask git, don't grep the exclude file (a commented or negated
  # rule would pass a grep but not real ignore behavior). check-ignore consults .gitignore + info/exclude.
  local probe="${exclude_marker%/}/.ship-feature-probe"
  if git check-ignore -q "$probe" 2>/dev/null; then
    ok "$exclude_marker is git-ignored"
  else
    die "$exclude_marker is not ignored — add it to $common_dir/info/exclude (or .gitignore)."
  fi

  # The default-branch tracking ref must be fetched to compare against it.
  git rev-parse --verify --quiet "origin/$def" >/dev/null 2>&1 || die "cannot resolve origin/$def — run 'git fetch' first."

  # Ancestry: the feature branch must actually descend from the current default branch.
  if git merge-base --is-ancestor "origin/$def" HEAD 2>/dev/null; then
    ok "branch descends from origin/$def"
  elif git merge-base "origin/$def" HEAD >/dev/null 2>&1; then
    if [ -n "${SHIP_FEATURE_ALLOW_BEHIND:-}" ]; then
      warn "branch is behind or diverged from origin/$def — allowed via SHIP_FEATURE_ALLOW_BEHIND."
    else
      die "branch is behind or diverged from origin/$def — rebase onto the default branch, or set SHIP_FEATURE_ALLOW_BEHIND=1 to proceed on a stale base."
    fi
  else
    die "no common history with origin/$def — did you branch off the default branch?"
  fi

  # The repository's gate. Last, so every earlier failure keeps its own message. No flag and no
  # variable skips it: a bypass written into the tooling is what the rule exists to prevent.
  local hook_err
  hook_err="$(sf_prepush_hook "$top" 2>&1)" || die "pre-push hook: $hook_err"
  ok "pre-push hook: .githooks/pre-push (committed, 100755, the hook git runs)"

  echo "✔ preflight passed."
}

cmd_relay() {
  command -v pr-review-relay >/dev/null 2>&1 || die "pr-review-relay not found on PATH (it is a dependency: https://github.com/hamen/pr-review-relay)."
  # `--autonomous` is ours, not the relay's: strip it and take the autonomous path (full panel, computed
  # verdict file, per-PR round counter). Without it, nothing below changes.
  local _auto=0 _rest=() _a
  for _a in "$@"; do case "$_a" in --autonomous) _auto=1;; *) _rest+=("$_a");; esac; done
  if [ "$_auto" = 1 ]; then cmd_relay_auto ${_rest[@]+"${_rest[@]}"}; return $?; fi
  load_config
  # If the caller omitted --reviewers and a quorum is configured, inject it (still fully overridable by
  # passing --reviewers yourself). stdout and the exact exit code are always preserved.
  local a has_reviewers=0
  for a in "$@"; do case "$a" in
    --reviewers) has_reviewers=1 ;;
    # pr-review-relay only accepts the two-token form; reject the =form with a clear message rather than
    # passing it through and letting the relay die with "unknown arg".
    --reviewers=*) die "pass reviewers as two tokens: --reviewers <list> (the --reviewers=... form isn't supported)." ;;
  esac; done
  if [ "$has_reviewers" = 1 ]; then
    pr-review-relay "$@"
  elif [ -n "${SHIP_FEATURE_REVIEWERS:-}" ]; then
    pr-review-relay "$@" --reviewers "$SHIP_FEATURE_REVIEWERS"
  else
    echo "  note: no explicit --reviewers and SHIP_FEATURE_REVIEWERS is unset — the relay may run a thinned panel. Set your quorum for a fail-closed cross-review." >&2
    pr-review-relay "$@"
  fi
  local rc=$?
  # Workflow-policy reminder only (on stderr, so it never pollutes the forwarded stdout).
  case "$rc" in
    # NOT "every reviewer ran": a benched (out-of-quota) reviewer is dropped deliberately and the run
    # still exits 0, so this message must not claim a full panel. And the loop rule is no longer
    # "resolve every Should-fix" — only qualifying ones open a round. The tool telling the operator
    # the old rule out-ranks any document, so it says the same thing WORKFLOW.md does — including
    # UNDISPUTED, without which it would push agents into re-rounds on findings the rule sends to Gate 2.
    0) echo "  → relay: every DISPATCHED reviewer ran (exit 0) — check the startup lines for a benched seat. NOT approval: READ the verdicts, resolve every Blocker and every UNDISPUTED qualifying Should-fix (correctness / safety / deployability / verification) — a disputed classification does not block the loop, it goes to Gate 2." >&2 ;;
    3) echo "  → relay: round not clean (exit 3) — do not trust these reviews, re-run." >&2 ;;
    4) echo "  → relay: round cap reached (exit 4) — stop and escalate to a human." >&2 ;;
  esac
  return $rc
}

# --- plan review (step 2 of the workflow) ------------------------------------
# Fan an implementation PLAN out to a panel of agents for a read-only review, BEFORE
# any code is written — the cheap gate that catches wrong assumptions and stale facts.
# Unlike `relay` (which reviews a PR via pr-review-relay and posts comments), this
# reviews a local plan file / stdin and prints each review to the terminal. Nothing
# is posted anywhere; nothing is written.
#
# Supported reviewers are ONLY those that can be run genuinely read-only over the plan
# text: claude (--permission-mode plan + --safe-mode, so no checkout hooks/plugins/MCP
# load either), codex (--sandbox read-only), cursor (--mode=ask,
# Q&A, on a model pinned away from Cursor's Auto — see CURSOR_REVIEW_MODEL below),
# glm (the opencode runner, model pinned via GLM_REVIEW_MODEL — see below — and pinned
# read-only by OPENCODE_CONFIG_CONTENT — opencode's
# highest-precedence config layer — denying `edit`+`bash` so nothing can be written even via
# shell, reading the checkout unless it carries its own opencode config, plus `--pure` and
# `--agent plan`), and antigravity via the `gemini` CLI run FAIL-CLOSED (see plan_review_with):
# an isolated GEMINI_CLI_HOME and workspace whose locked settings.json allowlists only read-only
# tools, disables hooks and loads no MCP, so no user- or checkout-scope config contributes a write
# tool. NOTE the deliberate overloading: in plan-review the reviewer name `antigravity` (aliases
# `agy`, `gemini`) maps to the `gemini` CLI — the only Gemini binary with a genuine read-only mode —
# whereas in `relay` `antigravity` maps to `agy`. TRADEOFF: because the run is fully isolated,
# gemini reviews the PLAN TEXT ONLY and cannot read the checkout; deep codebase fact-checking is the
# PR cross-review stage's job, not this cheap plan gate.
# Bare `opencode` is RELAY-ONLY here — a bare `opencode run` uses the all-allow build agent — so if
# listed it is skipped with a warning, never run. That keeps the "read-only, nothing is written"
# guarantee true for the whole set that actually runs.
plan_tool_for() { case "$1" in
  claude) echo claude;; codex) echo codex;; cursor) echo cursor-agent;; glm) echo opencode;;
  grok) echo grok;; antigravity) echo gemini;; *) echo "";; esac; }
# Named but deliberately not run in plan-review (available in `relay`). Note: `glm` IS a
# supported plan reviewer (read-only plan agent) and runs through the same `opencode` binary;
# only the bare `opencode` name is relay-only, because a bare `opencode run` uses the all-allow
# build agent.
# Bare `grok` is NOT relay-only any more: since 2026-09 it is one seat in both tools, pinned by
# MODEL_grok / EFFORT_grok. Plan-review called it `grok45high` and ran it at a hardcoded high
# effort; that name is now a deprecated alias (see the dispatch loop). A SHIP_FEATURE_REVIEWERS
# fallback that includes `grok` therefore RUNS it here, and needs the grok CLI installed.
# `antigravity`/`agy` are NO LONGER relay-only: they run here as the isolated `gemini` seat above.
plan_relay_only() { case "$1" in opencode) return 0;; *) return 1;; esac; }

cmd_plan_review() {
  load_config
  # Parallel by default: the reviewers are independent, so sequencing them only serializes
  # their timeouts. --sequential is the opt-out; --parallel is kept as a no-op so existing
  # scripts and docs that pass it keep working.
  local reviewers="" file="" parallel=1 have_file=0 have_reviewers=0
  while [ $# -gt 0 ]; do
    case "$1" in
      # Guard $2 so a trailing `--reviewers` (or one followed by a flag) is a clean usage
      # error, not a `set -u` unbound-variable crash.
      --reviewers)   [ $# -ge 2 ] || die "--reviewers needs a list (e.g. --reviewers codex,glm)."
                     case "$2" in -*) die "--reviewers needs a list, got the flag '$2'.";; esac
                     reviewers="$2"; have_reviewers=1; shift 2;;
      --reviewers=*) die "pass reviewers as two tokens: --reviewers <list> (the --reviewers=... form isn't supported)." ;;
      --parallel)    parallel=1; shift;;   # already the default; accepted so old callers don't break
      --sequential)  parallel=0; shift;;
      -h|--help)     echo "usage: ship-feature plan-review [<plan-file>] [--reviewers a,b,c] [--sequential]"
                     echo "       the panel runs in parallel by default (--parallel still accepted; last flag wins)"; return 0;;
      # Everything after `--` is positional — collect the plan file from there too, don't drop it.
      --)            shift; while [ $# -gt 0 ]; do [ "$have_file" = 0 ] || die "only one plan file may be given."; file="$1"; have_file=1; shift; done; break;;
      -)             [ "$have_file" = 0 ] || die "only one plan file may be given (got '$file' and '-')."; file="-"; have_file=1; shift;;   # '-' = read stdin
      -*)            die "unknown arg: $1" ;;
      *)             [ "$have_file" = 0 ] || die "only one plan file may be given (got '$file' and '$1')."; file="$1"; have_file=1; shift;;
    esac
  done

  # Resolve the plan text. Explicit `-` means "read stdin" even on a TTY (and never
  # falls back to ./plan.md). An explicit file wins next. Otherwise read stdin if it is
  # a pipe; an EMPTY pipe (common in CI / subprocesses) must NOT shadow ./plan.md, so
  # fall back to it when stdin yielded nothing.
  local plan="" src=""
  if [ "$have_file" = 1 ] && [ "$file" = "-" ]; then
    plan="$(cat)"; src="(stdin)"
    [ -n "$(printf '%s' "$plan" | tr -d '[:space:]')" ] || die "no plan on stdin (you passed '-')."
  elif [ "$have_file" = 1 ]; then
    [ -f "$file" ] || die "plan file not found: $file"
    plan="$(cat -- "$file")"; src="$file"
    [ -n "$(printf '%s' "$plan" | tr -d '[:space:]')" ] || die "plan file is empty: $file"
  else
    if [ ! -t 0 ]; then plan="$(cat)"; [ -n "$(printf '%s' "$plan" | tr -d '[:space:]')" ] && src="(stdin)"; fi
    # `./plan.md` is still read when it is there — breaking existing setups to
    # make a point would be worse than the point. But it is no longer SUGGESTED:
    # the message names the durable directory instead, because a plan in the cwd
    # is usually a plan in the repository, and always a plan a `rm -rf` of a
    # worktree takes with it.
    if [ -z "$(printf '%s' "$plan" | tr -d '[:space:]')" ] && [ -f plan.md ]; then
      plan="$(cat plan.md)"; src="plan.md"
      sf_ensure_plans_dir
      printf '  ! reading ./plan.md — keep plans in %s instead (see WORKFLOW.md §1)\n' "$SF_PLANS_DIR" >&2
    fi
    if [ -z "$(printf '%s' "$plan" | tr -d '[:space:]')" ]; then
      sf_ensure_plans_dir
      die "no plan given — pass a file (keep it in $SF_PLANS_DIR) or pipe it on stdin."
    fi
  fi

  # The seat's old spellings, reported HERE and nowhere else. `load_config` runs for every
  # command, so warning from inside it would print this on every `ship-feature relay` and
  # `ship-feature preflight` too — a deprecation notice about a plan-review seat, on a
  # cross-review run, about a key that pr-review-relay still accepts in its own PANEL_SEATS.
  # Recorded by the loaders, emitted once each, before the panel is dispatched.
  # Tokens are `<origin>:<key>` with no spaces, so the word-split below is safe and the origin
  # survives: a user who has the key in two places needs to be told which one is dead.
  local _dep
  for _dep in $SF_DEPRECATED_SEAT_KEYS; do
    case "$_dep" in
      env:KIMI3_REVIEW_MODEL)    warn "KIMI3_REVIEW_MODEL is set in the ENVIRONMENT. It is the old name of GLM_REVIEW_MODEL and is IGNORED — the plan-review seat is now 'glm'. Rename it (and check your shell profile), or the seat runs its default model.";;
      file:KIMI3_REVIEW_MODEL)   warn "KIMI3_REVIEW_MODEL is set in ship-feature's config. It is the old name of GLM_REVIEW_MODEL and is IGNORED — the plan-review seat is now 'glm'. Rename it, or the seat runs its default model.";;
      shared:MODEL_kimi3)        warn "MODEL_kimi3 is set in the shared panel config. It is the old name of MODEL_glm and is IGNORED HERE — the plan-review seat is now 'glm'. Rename it, or the seat runs its default model. (pr-review-relay still accepts the old key in its own PANEL_SEATS.)";;
      env:GROK45HIGH_REVIEW_MODEL)  warn "GROK45HIGH_REVIEW_MODEL is set in the ENVIRONMENT. It is the old name of GROK_REVIEW_MODEL and is IGNORED — the plan-review seat is now 'grok'. Rename it (and check your shell profile), or set MODEL_grok in the shared panel config.";;
      file:GROK45HIGH_REVIEW_MODEL) warn "GROK45HIGH_REVIEW_MODEL is set in ship-feature's config. It is the old name of the grok pin and is IGNORED — the plan-review seat is now 'grok'. Set MODEL_grok in the shared panel config instead.";;
      shared:MODEL_grok45high)   warn "MODEL_grok45high is set in the shared panel config. It is the old name of MODEL_grok and is IGNORED — the plan-review seat is now 'grok', and MODEL_grok / EFFORT_grok pin it in both tools. Delete it.";;
      # Not deprecated names — right names in the wrong file. These pins are read from the shared
      # panel config and the environment only (see load_config).
      file:CLAUDE_REVIEW_MODEL|file:CLAUDE_REVIEW_EFFORT|file:CODEX_REVIEW_MODEL|file:CODEX_REVIEW_EFFORT|file:GROK_REVIEW_MODEL|file:GROK_REVIEW_EFFORT)
                                 warn "${_dep#file:} is set in ship-feature's config and is IGNORED there. Set MODEL_<seat> / EFFORT_<seat> in the shared panel config (${PR_RELAY_CONFIG:-~/.config/pr-review-relay/config}), or export ${_dep#file:} in the environment.";;
      # A recorded token with no arm above would be recorded and never reported — silence, which is
      # the exact failure this whole block exists to end. Fail loud on our own bug too.
      *)                         warn "internal: no message for deprecated key token '$_dep' — please report this.";;
    esac
  done

  # Panel: --reviewers > SHIP_FEATURE_REVIEWERS > refuse. The resolved panel is your
  # QUORUM: every named+supported reviewer is required (a missing CLI fails the round),
  # so a review never silently passes on a thinned panel. agy/opencode are the exception.
  # An explicit but empty `--reviewers ""` is a usage error, not a silent fall-through to
  # the env panel (which would surprise a user who meant to name a list).
  if [ "$have_reviewers" = 1 ]; then
    [ -n "$reviewers" ] || die "--reviewers was empty — name at least one (e.g. --reviewers codex,glm)."
  else
    # Plan review can want a different (usually smaller) panel than the PR cross-review:
    # SHIP_FEATURE_PLAN_REVIEWERS is preferred, falling back to the shared quorum.
    reviewers="${SHIP_FEATURE_PLAN_REVIEWERS:-${SHIP_FEATURE_REVIEWERS:-}}"
    [ -n "$reviewers" ] || die "no reviewers — pass --reviewers <list> or set SHIP_FEATURE_PLAN_REVIEWERS / SHIP_FEATURE_REVIEWERS (e.g. claude,codex)."
  fi

  # Portable timeout: GNU `timeout`, else Homebrew `gtimeout`, else run WITHOUT a limit
  # (stock macOS ships neither) — a missing timeout must never break the reviewer.
  local TIMEOUT_BIN; TIMEOUT_BIN="$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)"
  # 500, matching pr-review-relay's own default. The panel runs reasoning models at high
  # effort; 300 was tuned when it did not, and an ordinary plan no longer fits — grok (then
  # `grok45high`, at high effort) timed out three times in one session on a plan whose only
  # fault was being thorough.
  #
  # The ladder, highest first: this variable (environment, then ~/.config/ship-feature/config),
  # then PR_RELAY_AGENT_TIMEOUT from the environment, then AGENT_TIMEOUT from
  # ~/.config/pr-review-relay/config (mapped onto this name by load_shared_panel_config), then
  # this literal. Rung 3 has to stay: without it a machine that exports PR_RELAY_AGENT_TIMEOUT
  # gets that value in the relay and the shared file's value here — two tools, two timeouts.
  local timeout_s="${SHIP_FEATURE_PLAN_TIMEOUT:-${PR_RELAY_AGENT_TIMEOUT:-500}}"
  # Reject non-digits AND values that are numerically zero ("0", "00", …): GNU
  # `timeout 0` DISABLES the timeout, the opposite of the intent. 10# forces base-10 so
  # a leading zero isn't read as octal.
  case "$timeout_s" in ''|*[!0-9]*) die "invalid SHIP_FEATURE_PLAN_TIMEOUT: '$timeout_s' (want a positive integer)";; esac
  [ "$((10#$timeout_s))" -gt 0 ] || die "invalid SHIP_FEATURE_PLAN_TIMEOUT: '$timeout_s' (must be > 0)"

  local PROMPT
  PROMPT="$(printf '%s' \
'You are reviewing an IMPLEMENTATION PLAN (provided on stdin), BEFORE any code is written.
Judge it for: wrong assumptions, stale or incorrect facts about the codebase, missing edge
cases, unhandled failure modes, risky or out-of-order steps, and anything it overlooks.
You have read-only access — do NOT write code or modify anything. Be concise. Group findings
by severity: Blocker / Should-fix / Nit. If the plan is sound, say so in one line.
You can read ONLY the current checkout. A plan that cites another repository, a dashboard or
an external service is not an invitation to go looking: those claims cannot be checked here,
so say the claim is unverified and move on. Do not spend the review trying to reach them —
a run that ends hunting for a file outside the checkout produces no review at all.
BUDGET YOUR TIME: you are cut off after a few minutes, and a run that is still reading files
when the clock stops delivers NOTHING — which is worse than a review with two claims left
unchecked. Verify only what could change your verdict, then stop reading and write. If you
have found something serious, write it down before you go looking for the next thing.')"

  # Autonomous mode only (plan-consensus sets SF_VERDICT_DIR): the verdict-line rules join the prompt.
  [ -z "${SF_VERDICT_DIR:-}" ] || PROMPT="$PROMPT
$SF_VERDICT_RULES"

  echo "▶ Plan review — reviewers: $reviewers${src:+ — plan: $src}$([ "$parallel" = 1 ] || printf ' — sequential')" >&2

  # Per-reviewer state lives in files so it survives the subshells used under --parallel
  # (same technique as pr-review-relay). The EXIT trap removes the dir; the INT/TERM trap
  # (below) tears down the reviewer process trees so an interrupt doesn't leave agents
  # running and burning credits.
  # umask 077 so the buffered review/diagnostic/status temp files created below are 0600 —
  # defence in depth on a shared machine, on top of the 0700 dir mktemp gives us. Not
  # restored: this is the CLI's terminal command, the process exits right after.
  umask 077
  # NOT `local`. The trap body below is single-quoted, so "$STATUS_DIR" is expanded when the trap
  # fires at EXIT — which happens after this function has already returned. A function-local would
  # be gone by then, `set -u` (line 19) would abort the trap body on the unbound name, and `rm`
  # would never run: the directory, holding every reviewer's buffered output, would survive every
  # single run. It did, ~310 a day, until this was found.
  STATUS_DIR="$(mktemp -d)" || die "cannot create temp dir"
  # (`trap "rm -rf -- $(printf '%q' "$STATUS_DIR")" EXIT` would be quote-safe AND allow `local`
  # again, removing the landmine above. Not taken: it trades a one-word fix for a subtler line, and
  # the regression test in test-ship-feature.sh already turns a relapse into two loud failures.)
  # Single-quoted trap body, double-quoted var: evaluated safely at exit even if a path
  # ever held a quote. Baking the path in with a double-quoted body would work only while the path
  # holds no single quote, which is exactly what this form was written to survive.
  # `--` so a TMPDIR that legitimately starts with '-' cannot have its path parsed as options.
  trap 'rm -rf -- "$STATUS_DIR"' EXIT
  # On interrupt, tear down the parallel reviewers so they don't keep burning credits.
  # kill_tree walks each backgrounded job's whole descendant tree (subshell → $() →
  # timeout → agent), which a group-kill can't reach because `timeout` re-groups its child.
  # `trap -` first, so a second ^C exits immediately.
  trap 'trap - INT TERM; for j in $(jobs -p 2>/dev/null); do kill_tree "$j"; done; exit 130' INT TERM
  skey() { printf 'k_%s' "$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')"; }

  # Run a reviewer command under the timeout when one is available, else directly.
  run_reviewer() { if [ -n "$TIMEOUT_BIN" ]; then "$TIMEOUT_BIN" "$timeout_s" "$@"; else "$@"; fi; }

  # Pin the Cursor reviewer's model. Left unset, cursor-agent falls back to whatever
  # ~/.cursor/cli-config.json holds — typically "Auto", which routes to the frontier models and is
  # free to pick a CLAUDE one. This command reviews a plan that Claude usually wrote, right before
  # the human approves it: Claude grading its own plan while the panel labels it an independent
  # "Cursor" reviewer defeats the point of the gate. (It also bills Cursor's small "Other Models"
  # quota instead of the much larger Cursor-branded pool.) composer-2.5 is Cursor's own model:
  # Cursor-pool, and not Claude, GPT, Codex or Grok, so every reviewer on the panel stays on the
  # model its own vendor built and they keep failing differently from each other.
  # Deliberately NOT named SHIP_FEATURE_*: it describes the user's Cursor account rather than this
  # tool, pr-review-relay reads the same variable, and one setting should configure both. It is
  # still read from the config file (load_config exports it there, so the child process sees it);
  # the environment keeps winning over the file.
  # `local` still reads the inherited/exported value on the RHS before the shadow takes effect, so
  # the override survives and nothing leaks to global scope. It is safe here only because this
  # variable is read inside the function and nowhere else; anything a trap expands must NOT be
  # local, since traps fire once the function has already returned.
  local CURSOR_REVIEW_MODEL="${CURSOR_REVIEW_MODEL:-composer-2.5}"

  # Pin the glm reviewer's model. Same override pattern as CURSOR_REVIEW_MODEL above: config
  # file or environment, local so the override survives without leaking to global scope. Left
  # unset in BOTH, it falls back to the bundled OpenCode Go tier — put
  # GLM_REVIEW_MODEL=openrouter/<vendor>/<model> in the config file to route through a
  # pay-as-you-go OpenRouter model instead.
  #
  # THE SEAT IS THE RUNNER, NOT THE MODEL. `glm` names the opencode runner pinned read-only, and
  # which model sits on it is this one line. It has carried Kimi K3 and two GLM releases, and
  # which is better is a property of the code under review, not of the seat: GLM won a measured
  # bake-off on a Kotlin diff, while Rails' own AI evals put Kimi K3 24 points ahead on Rails
  # tasks. That is a line in a config file, which is the point of it being there. The seat was
  # called `kimi3` until 2026-09 and by then had been running GLM for weeks — a name that lies
  # about which model reviewed your plan, which is why it was renamed.
  local GLM_REVIEW_MODEL="${GLM_REVIEW_MODEL:-opencode-go/glm-5.3}"

  # Pin the claude, codex and grok seats' model AND effort. Environment first (the relay's own
  # names, so one export pins both tools), then MODEL_<seat> / EFFORT_<seat> from the shared panel
  # config (load_shared_panel_config), then the default below.
  #
  # claude and codex default to NOTHING: an unpinned seat gets no extra argument and runs whatever
  # its CLI is configured for, exactly as before these pins existed. grok has always passed a model
  # and an effort, so it keeps defaults — medium, the relay's default for the same seat, so an
  # unpinned `grok` runs the same way in both tools. (It was a hardcoded `high` while the seat
  # was plan-review-only and called `grok45high`.)
  #
  # `local`, like the pins above: read here and in plan_review_with, never from a trap.
  local CLAUDE_REVIEW_MODEL="${CLAUDE_REVIEW_MODEL:-}" CLAUDE_REVIEW_EFFORT="${CLAUDE_REVIEW_EFFORT:-}"
  local CODEX_REVIEW_MODEL="${CODEX_REVIEW_MODEL:-}" CODEX_REVIEW_EFFORT="${CODEX_REVIEW_EFFORT:-}"
  local GROK_REVIEW_MODEL="${GROK_REVIEW_MODEL:-grok-4.6}" GROK_REVIEW_EFFORT="${GROK_REVIEW_EFFORT:-medium}"
  # Every one of these reaches a command line, and is user config. A leading '-' would be parsed as
  # a FLAG, not a value (the gemini check below says why that matters). An effort is a bare word:
  # codex's lands inside a TOML string (`model_reasoning_effort="…"`), where a quote would end it.
  # Only a value that will actually be passed is checked — an unpinned claude/codex effort is empty.
  # No per-CLI list of accepted levels: the CLIs add them, and a stale list here would refuse a
  # valid one. A level the CLI rejects fails that seat with the CLI's own error (exit 3, not clean).
  local _pin _pv
  for _pin in CLAUDE_REVIEW_MODEL CODEX_REVIEW_MODEL GROK_REVIEW_MODEL; do
    _pv="${!_pin}"
    case "$_pv" in -*) die "invalid $_pin: '$_pv' (must not start with '-').";; esac
  done
  for _pin in CLAUDE_REVIEW_EFFORT CODEX_REVIEW_EFFORT GROK_REVIEW_EFFORT; do
    _pv="${!_pin}"
    [ -z "$_pv" ] && continue
    case "$_pv" in -*|*[!A-Za-z0-9_-]*) die "invalid $_pin: '$_pv' (want a bare word such as 'medium').";; esac
  done
  # Arrays so an unset pin adds NO argument, not an empty one. Expanded with ${A[@]+"${A[@]}"}:
  # bash 3.2 under `set -u` treats an empty array as unbound.
  local -a CLAUDE_PIN_ARGS=() CODEX_PIN_ARGS=()
  [ -n "$CLAUDE_REVIEW_MODEL" ]  && CLAUDE_PIN_ARGS+=(--model "$CLAUDE_REVIEW_MODEL")
  [ -n "$CLAUDE_REVIEW_EFFORT" ] && CLAUDE_PIN_ARGS+=(--effort "$CLAUDE_REVIEW_EFFORT")
  [ -n "$CODEX_REVIEW_MODEL" ]   && CODEX_PIN_ARGS+=(-m "$CODEX_REVIEW_MODEL")
  [ -n "$CODEX_REVIEW_EFFORT" ]  && CODEX_PIN_ARGS+=(-c "model_reasoning_effort=\"$CODEX_REVIEW_EFFORT\"")
  # " (model=…, effort=…)" for the dispatch line. "cli default" when a pin adds no argument, so an
  # unpinned seat reads as unpinned rather than as a value nobody chose.
  plan_seat_pins() {
    case "$1" in
      claude) printf ' (model=%s, effort=%s)' "${CLAUDE_REVIEW_MODEL:-cli default}" "${CLAUDE_REVIEW_EFFORT:-cli default}";;
      codex)  printf ' (model=%s, effort=%s)' "${CODEX_REVIEW_MODEL:-cli default}" "${CODEX_REVIEW_EFFORT:-cli default}";;
      grok)   printf ' (model=%s, effort=%s)' "$GROK_REVIEW_MODEL" "$GROK_REVIEW_EFFORT";;
      cursor) printf ' (model=%s)' "$CURSOR_REVIEW_MODEL";;
      glm)    printf ' (model=%s)' "$GLM_REVIEW_MODEL";;
      antigravity) printf ' (model=%s)' "$GEMINI_MODEL";;
    esac
  }

  # Pin the gemini reviewer's model. The CLI's own built-in default is a retired model that 404s,
  # so this is not merely a preference — left unpinned the seat does not run at all. Override with
  # SHIP_FEATURE_GEMINI_MODEL (environment or config file) or MODEL_gemini in the shared panel file.
  local GEMINI_MODEL="${SHIP_FEATURE_GEMINI_MODEL:-gemini-3.1-pro-preview}"
  # This value reaches a command line as the argument to `-m`. It is user config, so reject a
  # leading '-': otherwise `SHIP_FEATURE_GEMINI_MODEL=--yolo` is parsed by gemini as a FLAG rather
  # than as a model name, and the seat's whole read-only premise turns on a config typo.
  case "$GEMINI_MODEL" in -*) die "invalid SHIP_FEATURE_GEMINI_MODEL: '$GEMINI_MODEL' (must not start with '-').";; esac

  # The gemini-cli releases whose TOOL REGISTRY this seat has been audited against. See the gate in
  # the antigravity arm of plan_review_with for why a version pin is load-bearing here and not
  # merely tidy. EXACT versions, space- or comma-separated — a patch release can add a tool as
  # easily as a minor one.
  local GEMINI_TESTED="${SHIP_FEATURE_GEMINI_TESTED_VERSIONS:-0.26.0}"

  # The locked, read-only settings the isolated gemini run loads (a single line so the heredoc-free
  # printf stays Bash 3.2-safe).
  #   - `tools.core` is an ALLOWLIST: of the tools gemini filters through it, ONLY these are enabled,
  #     so a write/exec/network tool that a future release adds to that set is off by default.
  #   - `tools.exclude` is an unconditional blocklist naming today's known write tools. It is NOT
  #     redundant: gemini registers some tools OUTSIDE the core-tool filter — `delegate_to_agent` in
  #     v0.26.0 — and for those the exclude list is the only thing standing in the way. That gap is
  #     exactly why the version gate below exists; the two controls together are complete only for a
  #     registry we have actually looked at.
  #   - hooks off, and no MCP servers.
  local GEMINI_LOCKED_SETTINGS='{"tools":{"core":["read_file","read_many_files","glob","search_file_content","list_directory"],"exclude":["run_shell_command","replace","write_file","web_fetch","google_web_search","save_memory","write_todos","delegate_to_agent"]},"hooksConfig":{"enabled":false},"mcpServers":{}}'

  # Does the checkout carry its own opencode configuration?
  #
  # glm reads the tree it reviews, which means the tree could otherwise reconfigure the
  # reviewer — MCP servers, agents, model routing. Permissions are already pinned by
  # OPENCODE_CONFIG_CONTENT and cannot be overridden, but nothing else is, and there is no
  # permission key for "ignore this repo's config". So when one of these exists the seat
  # degrades to an isolated empty dir instead.
  #
  # Prints the path of the first config found and returns 0; returns 1 when nothing is found.
  #
  # WALKS UP from $PWD, rather than checking one directory: plan-review is often run from a
  # subdirectory and opencode discovers config by walking up, so a $PWD-only check would miss a
  # config that opencode still loads. Stopping at the GIT ROOT is not enough either — this
  # workflow's own worktrees live at <repo>/.claude/worktrees/<name>, which is its own git
  # toplevel, so the main repo's opencode.json sits three levels up and outside that root.
  #
  # It STOPS AT $HOME, exclusive, and that bound is not a detail. `~/.opencode` exists on any
  # machine that has run opencode, so walking to / matches the user's own data directory for
  # every checkout under $HOME and degrades every review to prose. The distinction is whose
  # config it is: the user's own configuration is how the seat gets a model at all and is
  # trusted by construction; what must not configure the reviewer is the tree being REVIEWED.
  # Both paths are RESOLVED before comparing. A raw string compare misses a $HOME with a
  # trailing slash, and misses a symlinked $HOME against a physical $PWD — and the cost of
  # missing is not a warning, it is `~/.opencode` matching and every review silently degrading
  # to prose, which is the failure this bound exists to prevent.
  glm_repo_config() {
    local dir f home="" stop="" main=""
    dir="$(cd "$PWD" 2>/dev/null && pwd -P)" || dir="$PWD"
    [ -n "${HOME:-}" ] && home="$(cd "$HOME" 2>/dev/null && pwd -P)"
    # opencode stops project-config discovery at the worktree root (1.18.18), so walking past it
    # would degrade reviews over a config opencode never loads — and a needless prose-only review
    # is the very failure this change exists to end. Bound the walk there.
    stop="$(git rev-parse --show-toplevel 2>/dev/null && :)" || stop=""
    [ -n "$stop" ] && stop="$(cd "$stop" 2>/dev/null && pwd -P)"
    while :; do
      { [ -n "$home" ] && [ "$dir" = "$home" ]; } && return 1
      for f in opencode.json opencode.jsonc .opencode; do
        if [ -e "$dir/$f" ]; then printf '%s' "${dir}/${f}"; return 0; fi
      done
      [ -n "$stop" ] && [ "$dir" = "$stop" ] && break
      [ "$dir" = "/" ] && return 1
      dir="$(dirname "$dir")"
    done
    # A LINKED worktree is its own toplevel, so the loop above never sees the main checkout —
    # and this workflow puts every worktree at <repo>/.claude/worktrees/<name>, i.e. inside the
    # repo whose config we are guarding against. Check that root explicitly rather than by
    # walking, so the bound above stays honest.
    main="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
    [ -n "$main" ] || return 1
    main="$(cd "$(dirname "$main")" 2>/dev/null && pwd -P)" || return 1
    [ "$main" = "$dir" ] && return 1
    for f in opencode.json opencode.jsonc .opencode; do
      if [ -e "$main/$f" ]; then printf '%s' "${main}/${f}"; return 0; fi
    done
    return 1
  }

  # Both the review (stdout) and the diagnostics (stderr-bound) are buffered to files, so
  # under --parallel neither the reviews nor the failure messages interleave; the caller
  # emits them in panel order after the barrier. glm cannot modify your working tree: it pins
  # read-only through OPENCODE_CONFIG_CONTENT (opencode's highest-precedence config layer, applied
  # last so it wins over any merged global/project config) denying `edit`+`bash`, unsets any
  # inherited OPENCODE_CONFIG* so a hostile env can't pre-seed "allow", and adds --pure +
  # --agent plan. It reads the checkout (that is the point of a reviewer) unless the checkout
  # carries its own opencode config, in which case it degrades to an isolated empty dir.
  # Note: like every reviewer here, opencode still writes its own session data under its data
  # dir — the guarantee is "your checkout is untouched", not "nothing touches disk".
  plan_review_with() {
    local name="$1" out rc=0 errf key Name why ro_cwd="" prompt_file expected_bytes actual_bytes body sandbox_hint="" sandbox_unenforced="" degraded_note="" repo_opencode_config=""
    key="$(skey "$name")"; errf="$STATUS_DIR/err_$key"       # in STATUS_DIR so it can't leak
    Name="$(printf '%s' "${name:0:1}" | tr '[:lower:]' '[:upper:]')${name:1}"
    case "$name" in
      claude) out=$(printf '%s' "$plan" | run_reviewer claude -p --permission-mode plan --safe-mode ${CLAUDE_PIN_ARGS[@]+"${CLAUDE_PIN_ARGS[@]}"} "$PROMPT" 2>"$errf"); rc=$?;;
      codex)  out=$(printf '%s' "$plan" | run_reviewer codex exec --sandbox read-only ${CODEX_PIN_ARGS[@]+"${CODEX_PIN_ARGS[@]}"} "$PROMPT" 2>"$errf"); rc=$?;;
      cursor) out=$(printf '%s\n\n---\n%s' "$PROMPT" "$plan" | run_reviewer cursor-agent -p --mode=ask --model "$CURSOR_REVIEW_MODEL" 2>"$errf"); rc=$?;;
      glm)    # Pin read-only via OPENCODE_CONFIG_CONTENT — the HIGHEST-precedence config layer
              # (it is applied last, so it wins over any merged global/project/OPENCODE_CONFIG value;
              # verified: it overrides even a project opencode.json that sets edit/bash "allow").
              # Denying `edit`+`bash` removes those tools entirely, so nothing can be written — not
              # via a file edit, not via shell. We also unset any INHERITED OPENCODE_CONFIG* so a
              # hostile environment can't pre-seed an "allow". `--pure` skips external plugins;
              # `--agent plan` is defense in depth.
              #
              # RUNS IN THE CHECKOUT, like claude, codex, cursor and grok — and that is a
              # change. It used to run in an empty dir outside any checkout, which made the seat
              # useless in practice: with no tree to read, the model spends its turn hunting for
              # the repo, hits `permission requested: external_directory (…); auto-rejecting`, and
              # returns an empty review. Observed twice on 2026-08-14. A reviewer that cannot read
              # the code cannot catch a stale line number or a claim the source contradicts, which
              # is the entire reason for a panel.
              #
              # The isolation existed for one concrete reason: a repo's own opencode.json would be
              # discovered from the cwd. That reason is kept, not dropped — when the checkout ships
              # its own opencode config we fall back to the isolated empty dir and SAY SO in the
              # panel output, exactly as grok degrades when its sandbox cannot be enforced.
              # So the tree being reviewed can never reconfigure the reviewer reading it.
              #
              # Note the denial is belt and braces even in the checkout: the hostile-env test
              # proves OPENCODE_CONFIG_CONTENT wins over a project config that sets edit/bash
              # "allow". The fallback is about everything ELSE a repo config can carry (MCP
              # servers, agents, model routing), which no permission key covers.
              #
              # Two more denials, both learned by watching the seat fail with a tree to read:
              #
              #   external_directory — a rejected external read is FATAL to the run, not a tool
              #     that quietly returns nothing. Reviewing a plan that mentions another repo,
              #     the model reached for it, got auto-rejected, and the whole review ended
              #     there. Denying it up front (plus the prompt line telling reviewers that
              #     cross-repo claims are simply unverifiable here) keeps the turn alive.
              #   task — the plan agent can spawn parallel explore subagents, and it does. That
              #     is how a review that was verifying real claims against real files still
              #     produced nothing: it spent the whole per-reviewer budget in delegation and got cut off
              #     mid-sweep. The cap is not negotiable, so the fan-out has to go.
              #   lsp — a language server is a PROCESS the project starts, configured by the
              #     project. Denying bash and edit while leaving this on means the checkout can
              #     still run code; the seat's guarantee is that the reviewed tree executes
              #     nothing, so it goes too.
              #   webfetch + websearch — webfetch was "allow", and that was safe only while the
              #     seat had nothing to read. A reviewer that can read the tree AND reach the
              #     network is an exfiltration path the moment a file in that tree contains an
              #     instruction: these repos carry committed keystores and cached secrets. Both
              #     go, not just fetch — a search query carries content outward exactly as well
              #     as a URL does, and the enforcement here lives in the permission layer, not
              #     in the prompt asking nicely. The prompt tells reviewers not to chase
              #     external claims anyway, so this costs nothing.
              #
              # Both keys are in opencode's PermissionConfig schema (bash, doom_loop, edit,
              # external_directory, glob, grep, list, lsp, question, read, skill, task,
              # todowrite, webfetch, websearch) — checked, not guessed, because an unknown key
              # here would be ignored silently and the seat would keep failing the same way.
              ro_cwd=""
              if repo_opencode_config="$(glm_repo_config)"; then
                # FAIL CLOSED. If the isolated dir cannot be created, the alternative is running
                # in the very checkout whose config we just refused to load — while the note
                # below tells the reader it was isolated. Skip the seat instead: a missing
                # reviewer is visible, a lying one is not.
                if ! ro_cwd="$(TMPDIR=/tmp mktemp -d 2>/dev/null || mktemp -d)" || [ -z "$ro_cwd" ]; then
                  printf '  ! %s: %s found and no isolated cwd could be created — seat skipped\n' \
                    "$name" "$repo_opencode_config" > "$STATUS_DIR/diag_$key"
                  echo fail > "$STATUS_DIR/$key"; return 0
                fi
                degraded_note="! $repo_opencode_config would configure the reviewer — this review saw the plan text ONLY, not the code"
              fi
              out=$(cd "${ro_cwd:-$PWD}" \
                    && unset OPENCODE_CONFIG OPENCODE_CONFIG_DIR \
                    && export OPENCODE_CONFIG_CONTENT='{"permission":{"edit":"deny","bash":"deny","webfetch":"deny","websearch":"deny","external_directory":"deny","task":"deny","lsp":"deny"}}' \
                    && printf '%s\n\n--- PLAN ---\n%s' "$PROMPT" "$plan" \
                       | run_reviewer opencode run --pure --agent plan -m "$GLM_REVIEW_MODEL" 2>"$errf"); rc=$?
              [ -n "$ro_cwd" ] && rm -rf "$ro_cwd"
              true;;
      grok)
              # Grok headless ignores stdin: plan goes in --prompt-file (kept in STATUS_DIR, never
              # in the checkout, so it can't show up in anyone's `git status`).
              #
              # Runs in the CURRENT cwd — the checkout — exactly like claude, codex and cursor, so
              # it can verify the plan's claims against the code instead of reviewing prose. That
              # is the whole point of the panel: the reviewers that read the tree are the ones that
              # catch a stale line number or a test the change would turn red. The trade-off is the
              # same one those three already make: a checkout-scoped config (here `.grok`) is
              # loaded, just as CLAUDE.md / AGENTS.md / .cursor are for the others.
              #
              # Read-only is enforced by an ALLOWLIST: `--tools` names the only BUILT-INS the
              # session gets, which is what keeps out `run_terminal_command` (shell),
              # `search_replace` (editor), `spawn_subagent` and `scheduler_*`. A denylist would
              # have to enumerate every write path correctly, and an unknown name in
              # `--tools`/`--deny` is accepted silently, so a typo there fails OPEN.
              #
              # `--disallowed-tools search_tool,use_tool` is NOT redundant: the MCP bridge
              # survives the built-in allowlist. Verified — with `--tools read_file` alone the
              # session still reports `search_tool` and `use_tool`, i.e. every MCP server
              # configured on the machine stays reachable, including ones that write. With the
              # two removed, the session reports exactly read_file/list_dir/grep.
              #
              # Residual risk, stated because there is no flag for it: a checkout can still
              # contribute `.grok` config, hooks and plugins (`grok inspect` shows what a
              # directory yields). Grok has no `--safe-mode` equivalent to suppress them. What
              # remains is bounded by everything above — no shell tool, no MCP bridge, plan mode,
              # OS sandbox — but "runs code from the tree it reviews" is the same bet the other
              # in-checkout reviewers already make, not a guarantee we can make stronger here.
              # --permission-mode plan overrides machine always-approve; --sandbox read-only
              # is the OS write barrier (needs a working sandbox / bwrap on Linux). Note it can
              # warn and continue unenforced if setup fails, so it is a layer, not the guarantee.
              # Model and effort are the seat's pins (GROK_REVIEW_MODEL / GROK_REVIEW_EFFORT, or
              # MODEL_grok / EFFORT_grok) — the same pins the relay's grok seat reads.
              # PREVENTION, not just detection. Grok's own docs: a BUILT-IN profile that fails to
              # apply "logs a warning and continues without enforcement" — and by the time that
              # warning reaches us the checkout's hooks and plugins have already run. Discarding
              # the review afterwards is a signal, not a barrier. So refuse to START when the OS
              # barrier cannot be applied: on Linux that is bubblewrap plus unprivileged user
              # namespaces; macOS Seatbelt is available on all versions.
              # (Grok's fail-closed CUSTOM profiles live in ~/.grok/sandbox.toml or the
              # checkout's .grok/sandbox.toml — one is the user's own config, the other is a file
              # in someone else's repo. Neither is ours to write, hence this check instead.)
              # When it cannot be enforced we DEGRADE rather than refuse: back to the isolated
              # empty cwd with every tool denied — the posture this reviewer had before, which
              # needs no sandbox because there is nothing to write and nothing to read. You get a
              # text-only review (worse) instead of no review (worse still) or an unsandboxed one
              # in your checkout (worst).
              why=""
              case "${SHIP_FEATURE_FORCE_SANDBOX_PROBE:-}" in   # test-only override
                ok) ;;
                fail) why="forced by SHIP_FEATURE_FORCE_SANDBOX_PROBE";;
                *)
                  if [ "$(uname -s)" = Linux ]; then
                    command -v bwrap >/dev/null 2>&1 || why="bubblewrap (bwrap) not found"
                    if [ -z "$why" ] && [ -r /proc/sys/kernel/unprivileged_userns_clone ] \
                       && [ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null)" = 0 ]; then
                      why="unprivileged user namespaces are disabled"
                    fi
                  fi;;
              esac
              if [ -n "$why" ]; then
                ro_cwd="$(mktemp -d "$STATUS_DIR/iso-grok.XXXXXX")" || {
                  printf '  ! %s: cannot create isolated cwd (mktemp failed)\n' "$name" > "$STATUS_DIR/diag_$key"
                  echo fail > "$STATUS_DIR/$key"; return 0
                }
                degraded_note="! read-only sandbox cannot be enforced ($why) — this review saw the plan text ONLY, not the checkout"
              fi
              prompt_file="$STATUS_DIR/prompt_grok_$$"
              body="$(printf '%s\n\n--- PLAN ---\n~~~~plan\n%s\n~~~~\n--- END PLAN ---\n' "$PROMPT" "$plan")"
              if ! printf '%s' "$body" > "$prompt_file"; then
                printf '  ! %s: failed to write prompt-file\n' "$name" > "$STATUS_DIR/diag_$key"
                echo fail > "$STATUS_DIR/$key"; return 0
              fi
              expected_bytes=$(printf '%s' "$body" | wc -c | tr -d ' ')
              actual_bytes=$(wc -c < "$prompt_file" | tr -d ' ')
              if [ -z "$actual_bytes" ] || [ "$actual_bytes" = 0 ] || [ "$actual_bytes" != "$expected_bytes" ]; then
                printf '  ! %s: prompt-file write incomplete (expected %sB, got %sB)\n' \
                  "$name" "$expected_bytes" "${actual_bytes:-0}" > "$STATUS_DIR/diag_$key"
                echo fail > "$STATUS_DIR/$key"; [ -n "$ro_cwd" ] && rm -rf "$ro_cwd"; return 0
              fi
              if [ -n "$ro_cwd" ]; then      # degraded: isolated, no tools, no checkout
                out=$(cd "$ro_cwd" \
                      && run_reviewer grok \
                           --prompt-file "$prompt_file" \
                           --cwd "$ro_cwd" \
                           -m "$GROK_REVIEW_MODEL" \
                           --reasoning-effort "$GROK_REVIEW_EFFORT" \
                           --permission-mode plan \
                           --deny '*' \
                           --verbatim \
                           --no-memory \
                           --no-subagents \
                           --disable-web-search \
                           --max-turns 40 \
                           </dev/null 2>"$errf"); rc=$?
                rm -rf "$ro_cwd"
              else
                out=$(run_reviewer grok \
                         --prompt-file "$prompt_file" \
                         -m "$GROK_REVIEW_MODEL" \
                         --reasoning-effort "$GROK_REVIEW_EFFORT" \
                         --permission-mode plan \
                         --sandbox read-only \
                         --tools read_file,list_dir,grep \
                         --disallowed-tools search_tool,use_tool \
                         --verbatim \
                         --no-memory \
                         --no-subagents \
                         --disable-web-search \
                         --max-turns 40 \
                         </dev/null 2>"$errf"); rc=$?
              fi
              # Backstop to the pre-flight check above, for a sandbox that fails to apply for a
              # reason we cannot probe. Checked regardless of the exit code — a sandbox complaint
              # on stderr with a perfectly good review on stdout and exit 0 is exactly the silent
              # fail-open shape, and gating this on `rc != 0` (as it once did) meant the one case
              # worth catching was the one never inspected.
              # Matched on FAILURE PHRASING, not on the bare words "sandbox"/"namespace": those
              # appear in healthy logs too, and discarding a good review over the word "namespace"
              # would train people to ignore this.
              if [ -z "$ro_cwd" ] && [ -s "$errf" ] && grep -qiE 'continu(e|ing|es) (without enforcement|unsandboxed)|(sandbox|profile)[^.]{0,40}(could not|cannot|can'"'"'t|failed to) (be )?appl|failed to (set up|start|initiali[sz]e) (the )?sandbox|sandbox (is )?unavailable|running unsandboxed' "$errf" 2>/dev/null; then
                sandbox_hint="  ! $name: sandbox unavailable (check bubblewrap / user namespaces)"
                sandbox_unenforced=1
              fi;;
      antigravity)
        # Everything lives under STATUS_DIR (mktemp, 0700, cleaned on exit), normally in $TMPDIR and
        # outside any reviewed checkout. Two directories:
        #   ghome = GEMINI_CLI_HOME (holds the copied OAuth creds)
        #   gwork = the CWD / workspace
        # They are kept apart so the allowlisted read_file tool, which gemini restricts to the
        # workspace, does not have the credentials sitting in its own tree.
        #
        # Be precise about what that buys, because it is easy to overclaim: the control that keeps a
        # malicious plan from reading the credentials is gemini's workspace confinement, and nothing
        # here replaces it. Both directories must live inside STATUS_DIR — that is what gets cleaned
        # up, and credentials outside it could outlive the run — so they share an ancestor, and a
        # traversal that ignores confinement entirely reaches them whatever the layout. Keeping them
        # in separate subtrees only means the creds are not adjacent to the reviewer's own directory.
        # It is tidiness with a small safety margin, not a second line of defence.
        local ghome gwork
        ghome="$STATUS_DIR/gemini_home_$key/home"; gwork="$STATUS_DIR/gemini_work_$key/ws"
        # All initialised: the script runs under set -u, and a path that skips the probe would
        # otherwise reference an unset gver. Reachable only if the branch order ever changes, which
        # is exactly the kind of thing that changes.
        local gver="" gtested="" gver_ok="" giso_ok=""
        # Security-critical: if we can't create the locked settings, FAIL — never fall through to a
        # gemini run without the read-only config.
        # An empty `.gemini/.env` in the workspace (and home) stops gemini's ancestor `.env` search at
        # our controlled dir, so it can't pick up a hostile `/tmp/.env` (or any ancestor .env) that sets
        # CODE_ASSIST_ENDPOINT / a base-URL override and redirects auth or bearer tokens to an attacker.
        if mkdir -p "$ghome/.gemini" "$gwork/.gemini" \
           && printf '%s' "$GEMINI_LOCKED_SETTINGS" > "$ghome/.gemini/settings.json" \
           && printf '%s' "$GEMINI_LOCKED_SETTINGS" > "$gwork/.gemini/settings.json" \
           && printf '%s' '{}' > "$ghome/.gemini/system-defaults.json" \
           && : > "$ghome/.gemini/.env" && : > "$gwork/.gemini/.env"; then giso_ok=1; fi

        # FAIL-CLOSED VERSION GATE. `tools.core` is an allowlist, but gemini registers some tools
        # outside that filter, and for those the blocklist is the sole control: a release that adds
        # another one the same way passes both while this seat keeps claiming it cannot write. No CLI
        # call dumps the active registry, so the only honest control is to run exclusively against a
        # version whose registry someone has actually read, and to refuse otherwise.
        #
        # The probe runs INSIDE the same isolation as the review. `gemini --version` is still gemini
        # starting up, and if a release loads user or checkout configuration on that path — hooks, an
        # MCP server — then probing on the caller's environment would execute exactly the config this
        # seat exists to neutralise, before the gate it is meant to guard has even been evaluated.
        #
        # The match is on the FULL version, not major.minor. A patch release can add a tool as easily
        # as a minor one, and "0.26.x is close enough to the 0.26.0 we audited" is precisely the
        # assumption this gate exists to refuse. Widening it is deliberate: audit the release, then
        # add its exact version to SHIP_FEATURE_GEMINI_TESTED_VERSIONS.
        if [ -n "$giso_ok" ]; then
          # Parse the first digits.digits(.digits) token, greedily, rather than trusting the whole
          # line: a CLI may print a banner around its version ("gemini-cli version 0.26.0 (abc123)").
          # This gate fails CLOSED, so a fragile parse does not leak — it refuses a binary that was in
          # fact audited, and blames the gate for it.
          # Under run_reviewer, like the review itself: a probe is a gemini start-up too, and an
          # unwrapped one can hang on network or auth with nothing to stop it — outside the
          # per-reviewer timeout, so the whole panel waits on a seat that never reports.
          gver="$( cd "$gwork" && run_reviewer env \
                     -u XDG_CONFIG_HOME -u GOOGLE_GENAI_USE_GCA \
                     -u CODE_ASSIST_ENDPOINT -u GEMINI_BASE_URL -u GOOGLE_GEMINI_BASE_URL \
                     GEMINI_CLI_HOME="$ghome" \
                     GEMINI_CLI_SYSTEM_SETTINGS_PATH="$ghome/.gemini/settings.json" \
                     GEMINI_CLI_SYSTEM_DEFAULTS_PATH="$ghome/.gemini/system-defaults.json" \
                     gemini -e none --version 2>&1 | grep -oE '[0-9]+(\.[0-9]+){1,2}' | head -n 1 )"
          gtested="$(printf '%s' "$GEMINI_TESTED" | tr ',' ' ')"
          if [ -n "$gver" ]; then case " $gtested " in *" $gver "*) gver_ok=1;; esac; fi
        fi

        if [ -z "$giso_ok" ]; then
          echo "could not create the isolated read-only gemini settings" > "$errf"; rc=1; out=""
        elif [ -z "$gver_ok" ]; then
          if [ -z "$gver" ]; then
            echo "could not determine the gemini-cli version (is \`gemini\` on PATH?); refusing to run the seat unverified" > "$errf"
          else
            echo "gemini-cli $gver is outside the audited set ($gtested): its tool registry has not been reviewed for this seat. Audit that release's tools, then add $gver to SHIP_FEATURE_GEMINI_TESTED_VERSIONS." > "$errf"
          fi
          rc=1; out=""
        else
          # Lock EVERY gemini settings scope to controlled files so no hostile config (user, workspace,
          # OR system — /etc/gemini-cli or an inherited GEMINI_CLI_SYSTEM_SETTINGS_PATH) can re-enable a
          # write tool, hook, or MCP server:
          #   - GEMINI_CLI_HOME=$ghome   → USER scope reads $ghome/.gemini/settings.json (locked);
          #   - cd $gwork                → WORKSPACE scope reads $gwork/.gemini/settings.json (locked);
          #   - SYSTEM_SETTINGS_PATH     → SYSTEM scope (highest precedence) is the locked file;
          #   - SYSTEM_DEFAULTS_PATH     → SYSTEM-DEFAULTS scope is an empty {}.
          # GEMINI_CLI_HOME also moves where gemini looks for OAuth creds, so COPY the real ones into
          # ghome (GEMINI_API_KEY-based auth needs nothing — it rides the inherited env). COPY, not
          # symlink: a symlink would let gemini's internal token-refresh writeFile follow it and mutate
          # the user's REAL ~/.gemini creds; the copies (0600 under the 0700 temp dir) absorb any refresh
          # write and are discarded on exit. `cp -L` DEREFERENCES: if the source cred is itself a symlink
          # we still get a real file (a plain `cp` would recreate the symlink and defeat this). A failed
          # copy just fails auth → fail-closed.
          # Auth: an explicit environment method — GEMINI_API_KEY, or Vertex, which needs BOTH
          # GOOGLE_GENAI_USE_VERTEXAI=true and its own credentials (GOOGLE_API_KEY alone selects
          # nothing in v0.26.0) — is the verified path; it rides the inherited env and needs nothing
          # here. ONLY when NO such env auth is selected do we fall back to the user's OAuth: copy the
          # real creds into ghome and opt in with GOOGLE_GENAI_USE_GCA=true (the locked settings drop
          # the user's `security.auth.selectedType`, so non-interactive gemini would otherwise refuse
          # OAuth). Gating on "no env auth" matters because GCA takes precedence over an API key, so a
          # stale ~/.gemini would otherwise break an otherwise valid GEMINI_API_KEY run. An
          # INHERITED GOOGLE_GENAI_USE_GCA is dropped for the child (see the `-u` below) rather than
          # honoured: gemini gives GCA priority over both an API key and Vertex, and the branch below
          # deliberately does not copy credentials when env auth is selected — so an exported GCA
          # would win the auth race and then have nothing to authenticate with. `env` applies -u
          # before NAME=value, so opting in below still works.
          local realhome="${HOME:-}" gca_env=""
          [ -n "$realhome" ] || realhome="$(cd ~ 2>/dev/null && pwd)"
          # Vertex counts as SELECTED only when the flag is accompanied by credentials it can
          # actually use. The flag alone is a common leftover in a shell profile, and treating it as
          # auth suppressed the OAuth fallback and left the run with nothing — the same failure the
          # GOOGLE_API_KEY change fixed, arriving by a different door. ADC counts, as does an API key
          # (Vertex express mode accepts one) and an explicit service-account file.
          local env_auth="" vertex_ok=""
          if [ "${GOOGLE_GENAI_USE_VERTEXAI:-}" = "true" ]; then
            { [ -n "${GOOGLE_API_KEY:-}" ] || [ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ] \
              || { [ -n "$realhome" ] && [ -e "${CLOUDSDK_CONFIG:-$realhome/.config/gcloud}/application_default_credentials.json" ]; }; } && vertex_ok=1
          fi
          { [ -n "${GEMINI_API_KEY:-}" ] || [ -n "$vertex_ok" ]; } && env_auth=1
          if [ -z "$env_auth" ] && [ -n "$realhome" ]; then
            local cf; for cf in oauth_creds.json google_accounts.json; do
              if [ -e "$realhome/.gemini/$cf" ]; then
                # Warn (into $errf, surfaced if the reviewer then fails) when a real cred exists but can't
                # be copied — otherwise an OAuth user just sees an opaque auth failure.
                if cp -L "$realhome/.gemini/$cf" "$ghome/.gemini/$cf" 2>/dev/null; then
                  if chmod 600 "$ghome/.gemini/$cf" 2>/dev/null; then
                    gca_env="GOOGLE_GENAI_USE_GCA=true"
                  else
                    # Copy succeeded, tightening did not. Removing it is the only fail-closed move:
                    # skipping the GCA opt-in alone would leave a credential in the sandbox at the
                    # source's mode, unused — all of the exposure, none of the benefit.
                    rm -f "$ghome/.gemini/$cf" 2>/dev/null
                    echo "warning: copied ~/.gemini/$cf into the isolated home but could not chmod it; the copy was removed and OAuth auth may fail (set GEMINI_API_KEY instead)" >> "$errf"
                  fi
                else
                  echo "warning: could not copy ~/.gemini/$cf into the isolated home; OAuth auth may fail (set GEMINI_API_KEY instead)" >> "$errf"
                fi
              fi
            done
          fi
          # $errf is absolute, so the redirect survives the cd.
          # -u XDG_CONFIG_HOME: defence-in-depth in case a future gemini honors an XDG config path.
          out=$( cd "$gwork" && printf '%s' "$plan" | run_reviewer env \
                   -u XDG_CONFIG_HOME \
                   -u GOOGLE_GENAI_USE_GCA \
                   -u CODE_ASSIST_ENDPOINT -u GEMINI_BASE_URL -u GOOGLE_GEMINI_BASE_URL \
                   ${gca_env:+"$gca_env"} \
                   GEMINI_CLI_HOME="$ghome" \
                   GEMINI_CLI_SYSTEM_SETTINGS_PATH="$ghome/.gemini/settings.json" \
                   GEMINI_CLI_SYSTEM_DEFAULTS_PATH="$ghome/.gemini/system-defaults.json" \
                   gemini -e none -m "$GEMINI_MODEL" -p "$PROMPT" 2>>"$errf" ); rc=$?
          # APPEND, not truncate. The cred-copy warning above is already in $errf at this point, and
          # '>' would erase it just as the failure it explains is about to be reported. $errf is
          # created fresh per reviewer under STATUS_DIR, so there is no stale content to inherit.
        fi;;
    esac
    if [ -n "$sandbox_unenforced" ]; then
      { printf '  ! %s: read-only sandbox was not enforced — review discarded\n' "$name"
        printf '%s\n' "$sandbox_hint"
        [ -s "$errf" ] && tail -n 10 "$errf" | sed 's/^/    │ /'
      } > "$STATUS_DIR/diag_$key"
      echo fail > "$STATUS_DIR/$key"; return 0
    fi
    if [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ]; then
      why="exited with code $rc"
      case "$rc" in 0) why="ran but returned an empty review";; 124) why="timed out after ${timeout_s}s (raise SHIP_FEATURE_PLAN_TIMEOUT)";; 127) why="command not found";; esac
      { printf '  ! %s: no review — %s\n' "$name" "$why"
        [ -n "$sandbox_hint" ] && printf '%s\n' "$sandbox_hint"
        [ "$rc" != 124 ] && [ -s "$errf" ] && tail -n 10 "$errf" | sed 's/^/    │ /'
      } > "$STATUS_DIR/diag_$key"
      echo fail > "$STATUS_DIR/$key"; return 0
    fi
    # Autonomous mode only: keep the RAW seat text (no banner) and note a degraded seat, for plan-consensus.
    if [ -n "${SF_VERDICT_DIR:-}" ]; then
      printf '%s\n' "$out" > "$SF_VERDICT_DIR/raw_$key"
      [ -z "$degraded_note" ] || : > "$SF_VERDICT_DIR/degraded_$key"
    fi
    { printf '\n========== %s (plan review) ==========\n' "$Name"
      [ -n "$degraded_note" ] && printf '%s\n\n' "$degraded_note"
      printf '%s\n=======================================\n' "$out"
    } > "$STATUS_DIR/out_$key"
    if [ "$rc" -ne 0 ]; then
      # Name the timeout explicitly: a bare "exited with code 124" is opaque.
      if [ "$rc" = 124 ]; then printf '  ! %s: timed out after %ss — review may be truncated (not clean)\n' "$name" "$timeout_s" > "$STATUS_DIR/diag_$key"
      else printf '  ! %s: exited with code %s — review may be truncated (not clean)\n' "$name" "$rc" > "$STATUS_DIR/diag_$key"; fi
      [ -n "$sandbox_hint" ] && printf '%s\n' "$sandbox_hint" >> "$STATUS_DIR/diag_$key"
      echo fail > "$STATUS_DIR/$key"
    else echo ok > "$STATUS_DIR/$key"; fi
  }

  # plan-consensus counts its attempt HERE: after every check above that can refuse the run (this
  # function's own temp dir included) and right before the first seat starts, so only a dispatched
  # panel spends an attempt. The write is checked: one that fails silently would leave the old value,
  # and the cap would never bind.
  if [ -n "${SF_ATTEMPT_FILE:-}" ]; then
    case "${SF_ATTEMPT_N:-}" in ''|*[!0-9]*) echo "✖ plan-consensus: no valid attempt number to record. No reviewer ran. STOP and notify the human." >&2; return 5;; esac
    sf_num_put "$SF_ATTEMPT_FILE" "$SF_ATTEMPT_N" || { echo "✖ plan-consensus: cannot record the attempt in ${SF_ATTEMPT_FILE%/*} (read-only or full?). No reviewer ran. STOP and notify the human." >&2; return 5; }
  fi

  # Dispatch, de-duping the panel. `set -f` guards the word-split from pathname expansion
  # (an unquoted `$reviewers` would otherwise glob a value like `a*`).
  local r rk tool seen="" order="" warned_grok45high=0
  local IFS_SAVE="$IFS"; set -f; IFS=','; set -- $reviewers; IFS="$IFS_SAVE"; set +f
  for r in "$@"; do
    r="$(printf '%s' "$r" | tr -d '[:space:]')"; [ -z "$r" ] && continue
    # In plan-review, `agy` and `gemini` are aliases of the `antigravity` seat: all three run the
    # `gemini` CLI, so they must collapse to ONE name or a panel naming two of them would run the
    # same reviewer twice and call it a quorum.
    { [ "$r" = "agy" ] || [ "$r" = "gemini" ]; } && r=antigravity
    # `grok45high` is the grok seat's OLD name (renamed 2026-09, when its effort stopped being a
    # hardcoded `high`). Collapsed here, before the de-dupe, so `grok,grok45high` runs grok once.
    # The warning is guarded by its own flag, not by that ordering: `grok45high,grok45high` passes
    # this line twice and must still warn once.
    if [ "$r" = grok45high ]; then
      r=grok
      if [ "$warned_grok45high" = 0 ]; then
        warned_grok45high=1
        warn "'grok45high' is the old name of the plan-review seat 'grok' — running 'grok'. Rename it in PLAN_REVIEWERS / --reviewers; its model and effort now come from MODEL_grok / EFFORT_grok."
      fi
    fi
    rk="$(skey "$r")"
    case " $seen " in *" $rk "*) continue;; esac
    seen="$seen $rk"
    if plan_relay_only "$r"; then
      warn "$r is relay-only (no read-only mode / needs file-attach) — not run in plan-review; skipping."
      continue
    fi
    tool="$(plan_tool_for "$r")"
    # A named reviewer that is unknown, or supported-but-not-installed, is a hard failure:
    # the panel is the quorum, so a review must not quietly pass with it missing.
    if [ -z "$tool" ]; then echo fail > "$STATUS_DIR/$rk"; warn "unknown reviewer '$r' → fail"; continue; fi
    if ! command -v "$tool" >/dev/null 2>&1; then echo fail > "$STATUS_DIR/$rk"; warn "$tool not installed (required by the panel) → fail"; continue; fi
    order="$order $rk"
    # The resolved pins go on the SAME line, printed by the parent before the seat starts: only a
    # seat that passed every check above is listed, and nothing here can interleave under
    # --parallel. Until this line existed a `bash -x` trace was the only way to see them.
    echo "  → $r reviewing…$(plan_seat_pins "$r")" >&2
    echo pending > "$STATUS_DIR/$rk"
    if [ "$parallel" = 1 ]; then
      plan_review_with "$r" &
    else
      # Sequential: run and stream this review immediately (no interleave risk), so a
      # slow first reviewer doesn't make the whole panel silent until the end.
      plan_review_with "$r"
      [ -f "$STATUS_DIR/out_$rk" ]  && cat "$STATUS_DIR/out_$rk"
      [ -f "$STATUS_DIR/diag_$rk" ] && cat "$STATUS_DIR/diag_$rk" >&2
    fi
  done
  [ "$parallel" = 1 ] && wait

  # Parallel: reviews and diagnostics were buffered per reviewer; emit them in panel
  # order now, so neither the stdout reviews nor the stderr failures interleave.
  if [ "$parallel" = 1 ]; then
    local e; for e in $order; do
      [ -f "$STATUS_DIR/out_$e" ]  && cat "$STATUS_DIR/out_$e"
      [ -f "$STATUS_DIR/diag_$e" ] && cat "$STATUS_DIR/diag_$e" >&2
    done
  fi

  # Fail-closed verdict. Only status files (k_*) are counted — out_/err_ are excluded.
  local f ran=0 failed=0 names=""
  for f in "$STATUS_DIR"/k_*; do
    [ -e "$f" ] || continue
    ran=$((ran + 1))
    if [ "$(cat "$f")" != ok ]; then failed=$((failed + 1)); names="$names ${f##*/k_}"; fi
  done
  if [ "$ran" = 0 ]; then
    die "no supported reviewers ran. plan-review supports: claude, codex, cursor, glm, grok, antigravity (aliases agy, gemini) — bare opencode is relay-only. Pass --reviewers with a supported agent."
  fi
  if [ "$failed" -gt 0 ]; then
    if [ -z "${SF_VERDICT_DIR:-}" ]; then
      echo "✖ Plan review NOT clean: $failed/$ran reviewer(s) failed —$names. Re-run THIS ROUND. If the SAME reviewer fails a SECOND consecutive attempt, drop that one reviewer, proceed with the rest, and tell the human about the reduced panel before Gate 1 — do not keep retrying it." >&2
    else
      echo "✖ Plan review NOT clean: $failed/$ran reviewer(s) failed —$names." >&2
    fi
    return 3
  fi
  if [ -z "${SF_VERDICT_DIR:-}" ]; then
    echo "✔ Plan review done — $ran/$ran reviewer(s) responded (cap: 6 rounds, same full panel every time). READ the findings: no Blocker/plan-qualifying Should-fix → straight to Gate 1. A Blocker or plan-qualifying Should-fix → revise the plan and run the next round at once; never ask the human for one more round; an unreviewed plan revision never reaches Gate 1. Round 6 with a plan-qualifying finding still open → do not run a round 7 on your own — write a disagreement summary (objection, classification, reason) and take it to Gate 1 instead." >&2
  else
    echo "✔ Plan review done — $ran/$ran reviewer(s) responded." >&2
  fi
  return 0
}

# --- autonomous mode (EXPERIMENTAL, off by default) --------------------------------------------------
# A closed loop with no human gate: plan consensus replaces Gate 1, a machine-checked merge gate
# replaces Gate 2. See WORKFLOW.md "Autonomous mode". What this is NOT: a security boundary. The
# agent runs as the user, with the user's gh token, so anything it can write (a file, an env var, a
# PR comment) it can forge. Each brake below makes the unsafe path need a deliberate, visible,
# logged act and fails closed on missing evidence — nothing here claims "the agent cannot".
#
# Exit codes of the new commands (never 1 for a policy stop, so a stop is not read as a usage error):
#   0 done / consensus / merged / an all_clean relay round
#   2 a round finished with findings: revise (the plan, or the code), then re-run
#   3 a seat failed or gave no usable verdict (no round counted)
#   4 round cap or failed-attempt cap  5 plan consensus impossible or capped: STOP and notify
#   6 merge-gate check failed: STOP    7 refused: keys missing or kill switch present
#   8 merged, but the audit comment was NOT posted: post it
SF_AUTO_MAX_ROUNDS=6          # relay rounds per PR (full panel each), counted per PR not per SHA
SF_AUTO_PLAN_MAX_ROUNDS=6     # plan-consensus rounds per plan, the same cap as the relay's
SF_AUTO_PLAN_MAX_ATTEMPTS=9   # plan-consensus calls that dispatch the panel, per plan; the next one exits 5
SF_AUTO_MAX_FAILS=4           # failed relay attempts per PR; at this count the next exits 4
SF_AUDIT_MAX_BYTES=60000      # the audit comment stays under GitHub's comment size limit (65536)

# The rules every reviewer prompt gets in autonomous mode (and only then): the verdict line is the
# machine-read contract. Identical to the pr-review-relay prompt rules (its --verdict-file mode).
SF_VERDICT_RULES='VERDICT LINE (required). The LAST line of your review must be exactly one of:
VERDICT: clean
VERDICT: findings blockers=<N> should_fix=<M>
"clean" means zero Blockers and zero Should-fix. A Should-fix is ONLY a material problem of
correctness, safety, deployability or verification; every style, wording or preference item is a
Nit and does not block. Write the verdict line once, as the final line, with nothing after it.'

sf_auto_cfg_dir()  { printf '%s/.config/ship-feature' "${HOME:-}"; }
sf_auto_state()    { printf '%s/autonomous' "${SHIP_FEATURE_STATE_DIR:-${HOME:-}/.local/state/ship-feature}"; }
sf_mkdirp()        { ( umask 077; mkdir -p "$1" ); }

# Refuses (7) unless BOTH keys are present and the kill switch is absent. $1 = 1 when --autonomous
# was given. The env var is the thing the user sets on purpose when launching a session; an agent
# that sets it itself has done so visibly (the audit comment records autonomous_env=1).
sf_auto_guard() {
  local off; off="$(sf_auto_cfg_dir)/AUTONOMOUS_OFF"
  if [ -e "$off" ]; then echo "✖ autonomous mode is switched off ($off exists). Stopping." >&2; return 7; fi
  if [ "${1:-0}" != 1 ]; then echo "✖ autonomous mode needs BOTH the --autonomous flag and SHIP_FEATURE_AUTONOMOUS=1 in the environment — the flag is missing." >&2; return 7; fi
  if [ "${SHIP_FEATURE_AUTONOMOUS:-}" != 1 ]; then echo "✖ autonomous mode needs BOTH the --autonomous flag and SHIP_FEATURE_AUTONOMOUS=1 in the environment — the environment key is missing." >&2; return 7; fi
  return 0
}

# A lock for the read-modify-write of round counters and verdict files: two sessions on the same PR or
# plan must not pick the same round or overwrite each other's verdict. The lock is a symlink whose target
# is the owner's pid: `ln -s` creates the link and its target in one step, so a lock never exists without
# an owner, and age never makes a lock stale. Only a lock whose owner is gone (the target is not a number,
# is 0, or `kill -0` fails) is taken over. The target is a bare pid, so the link dangles by design: test
# for it with `[ -L ]` or readlink, never `[ -e ]`.
# EVERY acquisition holds the guard directory `<lock>.guard`, so only the guard's holder can create a
# link. Between its readlink and its rm, the link can only disappear (its owner's unlock), never be
# replaced by another process's link, so a takeover never removes a lock that a third process just took.
# Two processes that start together: the one that loses the guard gets "held", as a lost race does.
# Known limits, both fail closed: a guard left by a crash blocks that lock, and a dead owner whose pid the
# system reuses (or a zombie owner) keeps the lock held; a human removes either one. A real directory at
# the lock path (the format before the symlink, which also held live locks) is never taken over or
# written into: `-n` stops ln from following a link to a directory, and the `[ -d ] && [ ! -L ]` test
# stops it from creating a name inside a real one.
sf_lock_try() { if [ -d "$1" ] && [ ! -L "$1" ]; then return 1; fi; ln -sn "$$" "$1" 2>/dev/null; }
sf_lock() {
  local d="$1.lock" g="$1.lock.guard" p rc=1
  mkdir "$g" 2>/dev/null || return 1
  p="$(readlink "$d" 2>/dev/null)"
  case "$p" in
    '') ;;
    *[!0-9]*|0) rm -f "$d" ;;
    *) kill -0 "$p" 2>/dev/null || rm -f "$d" ;;
  esac
  sf_lock_try "$d" && rc=0
  rmdir "$g" 2>/dev/null
  return "$rc"
}
# Removes only this process's own lock, and always returns 0: the callers return the round's status.
sf_unlock() { if [ "$(readlink "$1.lock" 2>/dev/null)" = "$$" ]; then rm -f "$1.lock"; fi; return 0; }

sf_sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'; else shasum -a 256 | awk '{print $1}'; fi; }
# KEY=value files: last value wins; prints nothing when the key is absent.
sf_kv_get() { awk -F= -v k="$2" '$1==k { sub(/^[^=]*=/, ""); v=$0; f=1 } END { if (f) print v }' "$1" 2>/dev/null; }
sf_num_get() { local v; v="$(cat "$1" 2>/dev/null)"; case "$v" in ''|*[!0-9]*) v=0;; esac; printf '%s' "$v"; }
sf_num_put() { local t="$1.tmp.$$"; printf '%s\n' "$2" > "$t" && mv -f "$t" "$1"; }
# A set of seat names: split on commas and blanks, drop empties, sort, join with commas.
sf_norm_set() { printf '%s\n' "$1" | tr ', \t' '\n\n\n' | sed '/^$/d' | sort -u | paste -sd, -; }
# Plan seats, with the aliases plan-review itself collapses (agy/gemini -> antigravity, grok45high -> grok).
# The plan panel in autonomous mode: PLAN_REVIEWERS from the relay config, normalized. Any other source
# (SHIP_FEATURE_PLAN_REVIEWERS in the environment or in the ship-feature config) must name the same set,
# or the panel is refused: a stale override would otherwise narrow the panel without a word. Prints the
# panel; on failure prints the reason and returns 1.
sf_auto_plan_panel() {
  local file other
  file="$(sf_norm_plan_seats "$(sf_relay_cfg_key PLAN_REVIEWERS)")"
  [ -n "$file" ] || { echo "PLAN_REVIEWERS is not set (or names no seat) in the relay config. Without it plan-review falls back to the PR panel and can skip a relay-only seat while reporting success. Set it."; return 1; }
  if [ -n "${SHIP_FEATURE_PLAN_REVIEWERS:-}" ]; then
    other="$(sf_norm_plan_seats "$SHIP_FEATURE_PLAN_REVIEWERS")"
    [ "$other" = "$file" ] || { echo "SHIP_FEATURE_PLAN_REVIEWERS ($other, from the environment or the ship-feature config) differs from PLAN_REVIEWERS in the relay config ($file). Autonomous mode never runs a panel other than the configured one: remove the override."; return 1; }
  fi
  printf '%s' "$file"
}
sf_norm_plan_seats() { printf '%s\n' "$1" | tr ', \t' '\n\n\n' | sed -e '/^$/d' -e 's/^agy$/antigravity/' -e 's/^gemini$/antigravity/' -e 's/^grok45high$/grok/' | sort -u | paste -sd, -; }
sf_set_without() { printf '%s\n' "$1" | tr ',' '\n' | grep -Fvx -- "$2" | sed '/^$/d' | paste -sd, -; }
sf_b64d() { local in; in="$(cat)"; printf '%s' "$in" | base64 --decode 2>/dev/null || printf '%s' "$in" | base64 -D 2>/dev/null; }

# A key exactly as pr-review-relay's own config defines it (last value wins, BOM stripped, quotes and
# inline comment removed). Fails (1) when the file or the key is missing: the caller then fails closed.
sf_relay_cfg_reviewers() { sf_relay_cfg_key REVIEWERS; }
sf_relay_cfg_key() {
  local want="$1" cfg="${PR_RELAY_CONFIG:-${HOME:-}/.config/pr-review-relay/config}" key val last="" have=0
  [ -f "$cfg" ] || return 1
  while IFS='=' read -r key val || [ -n "$key$val" ]; do
    key="${key#$'\xef\xbb\xbf'}"
    case "$key" in ''|\#*) continue;; esac
    key="$(printf '%s' "$key" | tr -d '[:space:]')"
    [ "$key" = "$want" ] || continue
    val="${val%%[[:space:]]#*}"
    val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
    case "$val" in \"*\") val="${val#\"}"; val="${val%\"}";; \'*\') val="${val#\'}"; val="${val%\'}";; esac
    last="$val"; have=1
  done < "$cfg"
  [ "$have" = 1 ] && [ -n "$last" ] || return 1
  printf '%s' "$last"
}

# One review's verdict, by the strict rule: the LAST non-empty line is exactly `VERDICT: clean` or a
# well-formed `VERDICT: findings blockers=N should_fix=M`, and it is the ONLY line starting `VERDICT:`.
# Anything else (missing, malformed, duplicated, wrong case, trailing text) is `unknown`, never clean.
sf_parse_verdict() {
  local f="$1" last n
  [ -s "$f" ] || { echo unknown; return 0; }
  n="$(grep -c '^VERDICT:' "$f")"
  [ "$n" = 1 ] || { echo unknown; return 0; }
  last="$(awk 'NF { l = $0 } END { print l }' "$f")"
  if [ "$last" = "VERDICT: clean" ]; then echo clean
  elif printf '%s\n' "$last" | grep -Eq '^VERDICT: findings blockers=[0-9]+ should_fix=[0-9]+$'; then echo findings
  else echo unknown; fi
}

# --- plan-consensus: Gate 1 without a human ---------------------------------------------------------
cmd_plan_consensus() {
  local file="" auto=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --autonomous) auto=1; shift;;
      --reviewers|--reviewers=*) echo "✖ plan-consensus refuses --reviewers: the panel is PLAN_REVIEWERS and is never narrowed." >&2; return 7;;
      -h|--help) echo "usage: ship-feature plan-consensus <plan-file> --autonomous   (needs SHIP_FEATURE_AUTONOMOUS=1)"; return 0;;
      -) die "plan-consensus reads a file path, never stdin.";;
      -*) die "unknown arg: $1";;
      *) [ -z "$file" ] || die "only one plan file may be given."; file="$1"; shift;;
    esac
  done
  sf_auto_guard "$auto" || return 7
  [ -n "$file" ] && [ -f "$file" ] || die "plan-consensus needs an existing plan file."
  # plan-review refuses an empty plan too, but only after the attempt is counted: refuse it here.
  [ -n "$(tr -d '[:space:]' < "$file")" ] || die "plan-consensus: the plan file is empty: $file"
  load_config
  local panel seats s abs state key pdir
  panel="$(sf_auto_plan_panel)" || { echo "✖ plan-consensus: $panel" >&2; return 5; }
  seats="$panel"
  for s in $(printf '%s' "$seats" | tr ',' ' '); do
    if plan_relay_only "$s"; then echo "✖ plan-consensus: '$s' is relay-only and cannot review a plan; the panel can never be complete. Fix PLAN_REVIEWERS." >&2; return 5; fi
    [ -n "$(plan_tool_for "$s")" ] || { echo "✖ plan-consensus: unknown plan reviewer '$s'." >&2; return 5; }
  done
  abs="$(cd "$(dirname "$file")" && pwd -P)/$(basename "$file")"
  state="$(sf_auto_state)"
  key="$(printf '%s' "$abs" | sf_sha256)"
  pdir="$state/plan/$key"; sf_mkdirp "$pdir" || { echo "✖ cannot create $pdir" >&2; return 5; }
  sf_lock "$pdir" || { echo "✖ plan-consensus: another plan-consensus run holds the lock for this plan ($pdir.lock). STOP and notify the human." >&2; return 5; }
  local rc=0
  sf_plan_consensus_run "$file" "$abs" "$seats" "$pdir" "$state"; rc=$?
  sf_unlock "$pdir"
  return "$rc"
}

sf_plan_consensus_run() {
  local file="$1" abs="$2" seats="$3" pdir="$4" state="$5" rounds attempts vdir s sha_before sha_after
  # Idempotent after success: a consensus for this exact text and the current panel already exists, so
  # a re-run must not spend the panel again (and risk a new finding turning a valid result into a stop).
  sha_before="$(sf_sha256 < "$file")"
  if [ -f "$state/consensus/plan-$sha_before.consensus" ] && [ "$(sf_kv_get "$state/consensus/plan-$sha_before.consensus" plan_panel)" = "$seats" ] \
     && [ "$(sf_kv_get "$state/consensus/plan-$sha_before.consensus" plan_path)" = "$abs" ]; then
    echo "✔ plan-consensus: consensus for this exact plan text and panel already exists — Plan-Key: $sha_before" >&2
    return 0
  fi
  rounds="$(sf_num_get "$pdir/rounds")"; attempts="$(sf_num_get "$pdir/attempts")"
  if [ "$rounds" -ge "$SF_AUTO_PLAN_MAX_ROUNDS" ]; then echo "✖ plan-consensus: $rounds rounds already ran for this plan (cap $SF_AUTO_PLAN_MAX_ROUNDS). STOP and notify the human; no more rounds and no reset." >&2; return 5; fi
  if [ "$attempts" -ge "$SF_AUTO_PLAN_MAX_ATTEMPTS" ]; then echo "✖ plan-consensus: $attempts attempts already ran for this plan (cap $SF_AUTO_PLAN_MAX_ATTEMPTS). STOP and notify the human." >&2; return 5; fi

  vdir="$(mktemp -d)" || { echo "✖ cannot create a temp dir" >&2; return 5; }
  # The plan is hashed BEFORE the panel reads it and again after: a clean result must describe the text
  # the reviewers actually saw, not a file edited under them.
  sha_before="$(sf_sha256 < "$file")"
  # An attempt is a call that dispatches the panel: plan-review records it (SF_ATTEMPT_FILE) after every
  # check that can refuse the run, right before the first seat starts, so a refused call spends nothing.
  # A write that fails stops there with exit 5, before any seat runs.
  # On the last attempt no later call can dispatch, so a result that would say "run again" (exit 2 or 3)
  # is a stop (exit 5) instead. An all-clean round still exits 0.
  local last=0; [ $((attempts + 1)) -ge "$SF_AUTO_PLAN_MAX_ATTEMPTS" ] && last=1
  local rc=0
  ( export SF_VERDICT_DIR="$vdir" SHIP_FEATURE_PLAN_REVIEWERS="$seats" SF_ATTEMPT_FILE="$pdir/attempts" SF_ATTEMPT_N=$((attempts + 1)); cmd_plan_review "$file" ); rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -rf "$vdir"
    if [ "$rc" = 3 ]; then
      if [ "$last" = 1 ]; then echo "✖ plan-consensus: a seat failed — no round counted (attempt $((attempts + 1))/$SF_AUTO_PLAN_MAX_ATTEMPTS). No attempts left: STOP and notify the human." >&2; return 5; fi
      echo "✖ plan-consensus: a seat failed — no round counted (attempt $((attempts + 1))/$SF_AUTO_PLAN_MAX_ATTEMPTS). Run plan-consensus again; autonomous mode never drops a seat." >&2; return 3
    fi
    return "$rc"
  fi
  sha_after="$(sf_sha256 < "$file")"
  if [ "$sha_before" != "$sha_after" ]; then
    rm -rf "$vdir"
    if [ "$last" = 1 ]; then echo "✖ plan-consensus: the plan file changed while the panel was reading it — no consensus, no round counted (attempt $((attempts + 1))/$SF_AUTO_PLAN_MAX_ATTEMPTS). No attempts left: STOP and notify the human." >&2; return 5; fi
    echo "✖ plan-consensus: the plan file changed while the panel was reading it — no consensus, no round counted (attempt $((attempts + 1))/$SF_AUTO_PLAN_MAX_ATTEMPTS)." >&2
    return 3
  fi
  local v verdicts="" all_clean=1 unknown=0 degraded="" skey_s
  for s in $(printf '%s' "$seats" | tr ',' ' '); do
    skey_s="k_$(printf '%s' "$s" | tr -c 'A-Za-z0-9._-' '_')"
    v="$(sf_parse_verdict "$vdir/raw_$skey_s")"
    verdicts="$verdicts seat.$s=$v"
    [ "$v" = clean ] || all_clean=0
    [ "$v" = unknown ] && unknown=1
    { [ -e "$vdir/degraded_$skey_s" ] || [ "$s" = antigravity ]; } && degraded="${degraded:+$degraded,}$s"
  done
  rm -rf "$vdir"
  if [ "$unknown" = 1 ]; then
    if [ "$last" = 1 ]; then echo "✖ plan-consensus: a seat gave no usable VERDICT line —$verdicts. No round counted (attempt $((attempts + 1))/$SF_AUTO_PLAN_MAX_ATTEMPTS). No attempts left: STOP and notify the human." >&2; return 5; fi
    echo "✖ plan-consensus: a seat gave no usable VERDICT line —$verdicts. No round counted (attempt $((attempts + 1))/$SF_AUTO_PLAN_MAX_ATTEMPTS). Run plan-consensus again; autonomous mode never drops a seat." >&2
    return 3
  fi
  rounds=$((rounds + 1))
  sf_num_put "$pdir/rounds" "$rounds" || { echo "✖ plan-consensus: cannot record round $rounds in $pdir (read-only or full?). The round is not used. STOP and notify the human." >&2; return 5; }
  if [ "$all_clean" = 1 ]; then
    local sha cons; sha="$sha_before"
    sf_mkdirp "$state/consensus" || return 5
    cons="$state/consensus/plan-$sha.consensus"
    { printf 'plan_sha256=%s\nplan_path=%s\nround=%s\nseats=%s\nplan_panel=%s\ndegraded=%s\nts=%s\n' \
        "$sha" "$abs" "$rounds" "$seats" "$seats" "$degraded" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      for v in $verdicts; do printf '%s\n' "$v"; done
    } > "$cons.tmp.$$" && mv -f "$cons.tmp.$$" "$cons" || { echo "✖ cannot write $cons" >&2; return 5; }
    echo "✔ plan-consensus: every seat clean in round $rounds — Plan-Key: $sha" >&2
    [ -n "$degraded" ] && echo "  ! seats that reviewed the plan text only (named in the audit comment): $degraded" >&2
    return 0
  fi
  if [ "$rounds" -ge "$SF_AUTO_PLAN_MAX_ROUNDS" ]; then
    echo "✖ plan-consensus: round $rounds still has findings —$verdicts. Cap reached: STOP and notify the human." >&2; return 5
  fi
  if [ "$last" = 1 ]; then
    echo "✖ plan-consensus: round $rounds of $SF_AUTO_PLAN_MAX_ROUNDS had findings (attempt $((attempts + 1))/$SF_AUTO_PLAN_MAX_ATTEMPTS) —$verdicts. No attempts left: STOP and notify the human." >&2; return 5
  fi
  echo "✖ plan-consensus: round $rounds of $SF_AUTO_PLAN_MAX_ROUNDS had findings (attempt $((attempts + 1))/$SF_AUTO_PLAN_MAX_ATTEMPTS) —$verdicts. Revise the plan and run plan-consensus again." >&2
  return 2
}

# --- relay --autonomous: full-panel rounds, a computed verdict path, one counter per PR -------------
cmd_relay_auto() {
  local args=() pr="" repo a ctx=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --reviewers|--reviewers=*) echo "✖ relay --autonomous refuses --reviewers: every autonomous round is a full-panel round on the relay's own quorum." >&2; return 7;;
      --verdict-file|--verdict-file=*|--max-rounds|--max-rounds=*|--reset) echo "✖ relay --autonomous sets its own verdict path and round cap and never resets; '$1' is refused." >&2; return 7;;
      --pr) [ $# -ge 2 ] || die "--pr needs a number."; pr="$2"; args+=("$1" "$2"); shift 2;;
      --pr=*) pr="${1#--pr=}"; args+=(--pr "$pr"); shift;;   # pr-review-relay takes only `--pr N`
      --context-file|--context-file=*)
        [ -z "$ctx" ] || { echo "✖ relay --autonomous: --context-file given twice; pass the approved plan once." >&2; return 7; }
        if [ "$1" = --context-file ]; then [ $# -ge 2 ] || die "--context-file needs a path."; ctx="$2"; shift 2; else ctx="${1#--context-file=}"; shift; fi
        args+=(--context-file "$ctx");;   # pr-review-relay takes only `--context-file <path>`
      *) args+=("$1"); shift;;
    esac
  done
  sf_auto_guard 1 || return 7
  # A clean verdict counts toward a merge, so the reviewers must have read the plan it implements.
  [ -n "$ctx" ] && [ -f "$ctx" ] || { echo "✖ relay --autonomous needs --context-file <plan> (an existing file): a round whose reviewers never saw the approved plan cannot be a merge candidate." >&2; return 7; }
  # The context must BE a plan that reached consensus, byte for byte. Its hash goes into the verdict
  # file, and the merge gate requires it to equal the PR's Plan-Key.
  SF_RA_CTX="$ctx"; SF_RA_CSHA="$(sf_sha256 < "$ctx")"
  [ -f "$(sf_auto_state)/consensus/plan-$SF_RA_CSHA.consensus" ] || { echo "✖ relay --autonomous: the --context-file is not a plan that reached consensus (no result for its SHA-256 $SF_RA_CSHA). Pass the approved plan file itself, unchanged." >&2; return 7; }
  command -v pr-review-relay >/dev/null 2>&1 || die "pr-review-relay not found on PATH (it is a dependency: https://github.com/hamen/pr-review-relay)."
  command -v gh >/dev/null 2>&1 || die "gh not found on PATH."
  repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)" || repo=""
  # A lookup that fails is a retry (3), not the round cap (4): nothing ran and nothing was counted. It
  # still fails closed: no relay runs without a known repo and PR. There is no per-PR counter yet, so
  # the bound is the caller's: a second failure in a row is a stop.
  [ -n "$repo" ] || { echo "✖ relay --autonomous: cannot resolve the repository (gh repo view failed). Nothing ran; run again, and stop if it fails twice." >&2; return 3; }
  if [ -n "$pr" ]; then
    case "$pr" in *[!0-9]*) echo "✖ relay --autonomous: --pr needs a PR number, got '$pr'." >&2; return 7;; esac
  else
    pr="$(gh pr view --json number --jq .number 2>/dev/null)" || pr=""
    case "$pr" in ''|*[!0-9]*) echo "✖ relay --autonomous: cannot resolve one PR for this branch (gh pr view failed or found none). Nothing ran; pass --pr N or run again, and stop if it fails twice." >&2; return 3;; esac
  fi
  local dir rc
  dir="$(sf_auto_state)/$(printf '%s' "$repo" | tr '/' '_')/pr-$pr"
  sf_mkdirp "$dir" || { echo "✖ cannot create $dir" >&2; return 4; }
  sf_lock "$dir" || { echo "✖ relay --autonomous: another autonomous round holds the lock for $repo#$pr ($dir.lock). STOP and notify the human." >&2; return 4; }
  sf_relay_auto_round "$repo" "$pr" "$dir" ${args[@]+"${args[@]}"}; rc=$?
  sf_unlock "$dir"
  return "$rc"
}

sf_relay_auto_round() {
  local repo="$1" pr="$2" dir="$3" rounds fails k vf rc
  shift 3
  rounds="$(sf_num_get "$dir/rounds")"; fails="$(sf_num_get "$dir/fails")"
  if [ "$rounds" -ge "$SF_AUTO_MAX_ROUNDS" ]; then echo "✖ relay --autonomous: cap of $SF_AUTO_MAX_ROUNDS rounds reached for $repo#$pr. STOP and notify the human." >&2; return 4; fi
  if [ "$fails" -ge "$SF_AUTO_MAX_FAILS" ]; then echo "✖ relay --autonomous: $fails failed attempts for $repo#$pr (cap $SF_AUTO_MAX_FAILS). STOP and notify the human." >&2; return 4; fi
  k=$((rounds + 1)); vf="$dir/round-$k.verdict"
  # Every counter write is checked, and both counters are rewritten BEFORE the relay runs, so a state
  # directory that cannot be written stops here instead of dispatching a round the caps cannot count.
  { rm -f "$vf" && sf_num_put "$dir/rounds" "$rounds" && sf_num_put "$dir/fails" "$fails"; } 2>/dev/null \
    || { echo "✖ relay --autonomous: cannot write the round state in $dir (read-only or full?). No reviewer ran. STOP and notify the human." >&2; return 4; }
  pr-review-relay "$@" --verdict-file "$vf" --max-rounds "$SF_AUTO_MAX_ROUNDS"; rc=$?
  local ac=""
  if [ "$rc" = 0 ]; then
    ac="$(sf_kv_get "$vf" all_clean)"
    # A round counts only when the file is this PR's and says true or false. Anything else is not a
    # verdict: a junk or foreign file must not count, and must not stay behind as the highest round.
    # The context is hashed again: a plan edited while the panel read it means the reviewers did not see
    # the text the recorded hash names.
    if [ "$(sf_sha256 < "$SF_RA_CTX" 2>/dev/null)" != "$SF_RA_CSHA" ]; then
      rm -f "$vf"
      fails=$((fails + 1))
      sf_num_put "$dir/fails" "$fails" 2>/dev/null || { echo "✖ relay --autonomous: cannot record the failed attempt in $dir. STOP and notify the human." >&2; return 4; }
      echo "✖ relay --autonomous: the context file changed while the panel was reading it. Round not counted (failed attempt $fails/$SF_AUTO_MAX_FAILS)." >&2
      [ "$fails" -ge "$SF_AUTO_MAX_FAILS" ] && return 4
      return 3
    fi
    if [ ! -s "$vf" ] || [ "$(sf_kv_get "$vf" repo)" != "$repo" ] || [ "$(sf_kv_get "$vf" pr)" != "$pr" ] \
       || { [ "$ac" != true ] && [ "$ac" != false ]; }; then
      rm -f "$vf"
      fails=$((fails + 1))
      sf_num_put "$dir/fails" "$fails" 2>/dev/null || { echo "✖ relay --autonomous: cannot record the failed attempt in $dir. STOP and notify the human." >&2; return 4; }
      echo "✖ relay --autonomous: the relay exited 0 without a usable verdict file for $repo#$pr (missing, foreign, or no all_clean=true|false; pr-review-relay too old for --verdict-file?). Round not counted (failed attempt $fails/$SF_AUTO_MAX_FAILS)." >&2
      [ "$fails" -ge "$SF_AUTO_MAX_FAILS" ] && return 4
      return 3
    fi
    # The relay numbers its rounds per reviewed SHA; this wrapper numbers them per PR. Record the PR
    # round, which is the one the merge gate binds to the file name and caps at 6.
    { printf 'pr_round=%s\ncontext_sha256=%s\n' "$k" "$SF_RA_CSHA" >> "$vf" && sf_num_put "$dir/rounds" "$k"; } 2>/dev/null \
      || { rm -f "$vf"; echo "✖ relay --autonomous: cannot record round $k in $dir (read-only or full?). The round is not used. STOP and notify the human." >&2; return 4; }
    if [ "$ac" = true ]; then
      echo "  → relay --autonomous: round $k/$SF_AUTO_MAX_ROUNDS for $repo#$pr is all_clean. Run 'ship-feature merge-gate $pr --autonomous'." >&2
      return 0
    fi
    echo "  → relay --autonomous: round $k/$SF_AUTO_MAX_ROUNDS for $repo#$pr has findings (all_clean=false). READ the reviews; fix every Blocker and Should-fix, post the disposition, then run the next round." >&2
    return 2
  fi
  rm -f "$vf"
  case "$rc" in
    3) fails=$((fails + 1))
       sf_num_put "$dir/fails" "$fails" 2>/dev/null || { echo "✖ relay --autonomous: cannot record the failed attempt in $dir. STOP and notify the human." >&2; return 4; }
       if [ "$fails" -ge "$SF_AUTO_MAX_FAILS" ]; then echo "✖ relay --autonomous: failed attempt $fails/$SF_AUTO_MAX_FAILS for $repo#$pr — cap reached. STOP and notify the human." >&2; return 4; fi
       echo "  → relay --autonomous: a seat failed (exit 3), attempt $fails/$SF_AUTO_MAX_FAILS — not counted as a round." >&2; return 3;;
    4) echo "  → relay: round cap reached (exit 4) — STOP and notify the human." >&2; return 4;;
    *) # Any other exit (a usage error, a killed relay) is a failed attempt too, so it is bounded by the
       # same cap and never loops. It is reported as 3: the round produced no usable verdict.
       fails=$((fails + 1))
       sf_num_put "$dir/fails" "$fails" 2>/dev/null || { echo "✖ relay --autonomous: cannot record the failed attempt in $dir. STOP and notify the human." >&2; return 4; }
       if [ "$fails" -ge "$SF_AUTO_MAX_FAILS" ]; then echo "✖ relay --autonomous: the relay exited $rc; failed attempt $fails/$SF_AUTO_MAX_FAILS for $repo#$pr — cap reached. STOP and notify the human." >&2; return 4; fi
       echo "✖ relay --autonomous: the relay exited $rc (not 0, 3 or 4), attempt $fails/$SF_AUTO_MAX_FAILS — not counted as a round." >&2; return 3;;
  esac
}

# --- merge-gate: Gate 2 without a human -------------------------------------------------------------
sf_gate_fail() { echo "✖ merge-gate: $*" >&2; }

sf_default_sensitive() {
  cat <<'EOF'
.github/workflows/*
.githooks/*
*/hooks/*
*pre-push*
*deploy.yml*
.kamal/*
*Fastfile*
*.p8
*.jks
*.keystore
*.env
.env*
*/.env*
*secret*
*credential*
bin/mac-ios-build.sh
bin/build-ios-ipa.sh
*build-android.sh
EOF
}

# Check 2: the PR carries one Plan-Key, and a consensus result exists for exactly that plan.
sf_gate_plan() {
  local pr="$1" body keys n key cons state panel_now pp
  state="$(sf_auto_state)"
  body="$(gh pr view "$pr" --json body --jq .body 2>/dev/null)" || { sf_gate_fail "cannot read the PR body"; return 6; }
  n="$(printf '%s\n' "$body" | grep -c '^Plan-Key:')"
  keys="$(printf '%s\n' "$body" | sed -n 's/^Plan-Key: \([0-9a-f]\{64\}\)[[:space:]]*$/\1/p')"
  [ "$n" = 1 ] && [ "$(printf '%s' "$keys" | grep -c .)" = 1 ] || { sf_gate_fail "the PR body must carry exactly one well-formed 'Plan-Key: <sha256>' line (found $n Plan-Key line(s))"; return 6; }
  key="$keys"; cons="$state/consensus/plan-$key.consensus"; SF_G_PKEY="$key"
  [ -f "$cons" ] || { sf_gate_fail "no plan consensus result for Plan-Key $key"; return 6; }
  panel_now="$(sf_auto_plan_panel)" || { sf_gate_fail "$panel_now"; return 6; }
  [ "$(sf_kv_get "$cons" plan_panel)" = "$panel_now" ] || { sf_gate_fail "the plan panel changed since consensus (was $(sf_kv_get "$cons" plan_panel), now $panel_now)"; return 6; }
  pp="$(sf_kv_get "$cons" plan_path)"
  [ -n "$pp" ] || { sf_gate_fail "the consensus result names no plan_path"; return 6; }
  if [ -f "$pp" ]; then
    [ "$(sf_sha256 < "$pp")" = "$key" ] || { sf_gate_fail "the plan file changed after consensus ($pp)"; return 6; }
  fi
  SF_G_CONS="$cons"
  return 0
}

# Check 3: repository, state, base, mergeable.
sf_gate_pr() {
  local pr="$1" defb st dr base m i=0
  SF_G_REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)" || SF_G_REPO=""
  [ -n "$SF_G_REPO" ] || { sf_gate_fail "cannot resolve the repository"; return 6; }
  defb="$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name 2>/dev/null)" || defb=""
  [ -n "$defb" ] || { sf_gate_fail "cannot resolve the default branch"; return 6; }
  st="$(gh pr view "$pr" --json state --jq .state 2>/dev/null)"; [ "$st" = OPEN ] || { sf_gate_fail "PR is not open (state: ${st:-unknown})"; return 6; }
  dr="$(gh pr view "$pr" --json isDraft --jq .isDraft 2>/dev/null)"; [ "$dr" = false ] || { sf_gate_fail "PR is a draft (or draft state unreadable)"; return 6; }
  base="$(gh pr view "$pr" --json baseRefName --jq .baseRefName 2>/dev/null)"
  [ "$base" = "$defb" ] || { sf_gate_fail "PR base is '${base:-unknown}', the default branch is '$defb'"; return 6; }
  while :; do
    m="$(gh pr view "$pr" --json mergeable --jq .mergeable 2>/dev/null)"
    if [ "$m" = UNKNOWN ] && [ "$i" -lt 4 ]; then i=$((i + 1)); sleep "${SHIP_FEATURE_MERGEABLE_SLEEP:-10}"; continue; fi
    break
  done
  [ "$m" = MERGEABLE ] || { sf_gate_fail "PR is not mergeable (mergeable: ${m:-unknown})"; return 6; }
  SF_G_HEAD="$(gh pr view "$pr" --json headRefOid --jq .headRefOid 2>/dev/null)"
  printf '%s' "$SF_G_HEAD" | grep -Eq '^[0-9a-f]{40}$' || { sf_gate_fail "cannot read the PR head SHA"; return 6; }
  return 0
}

# Check 4: the verdict file of the HIGHEST round, for this repo and PR, on the current head.
sf_gate_verdict() {
  local pr="$1" vdir f n best=0 bestf="" cfg want have s conf author
  vdir="$(sf_auto_state)/$(printf '%s' "$SF_G_REPO" | tr '/' '_')/pr-$pr"
  for f in "$vdir"/round-*.verdict; do
    [ -e "$f" ] || continue
    n="${f##*/round-}"; n="${n%.verdict}"
    case "$n" in ''|*[!0-9]*) continue;; esac
    [ "$n" -gt "$best" ] && { best="$n"; bestf="$f"; }
  done
  [ -n "$bestf" ] || { sf_gate_fail "no verdict file for $SF_G_REPO#$pr (run 'ship-feature relay --autonomous')"; return 6; }
  [ "$(sf_kv_get "$bestf" repo)" = "$SF_G_REPO" ] || { sf_gate_fail "the verdict file names another repository"; return 6; }
  [ "$(sf_kv_get "$bestf" pr)" = "$pr" ] || { sf_gate_fail "the verdict file names another PR"; return 6; }
  [ "$(sf_kv_get "$bestf" pr_round)" = "$best" ] || { sf_gate_fail "the verdict file's pr_round does not match its name (not written by relay --autonomous?)"; return 6; }
  [ "$best" -le "$SF_AUTO_MAX_ROUNDS" ] || { sf_gate_fail "round $best is past the cap of $SF_AUTO_MAX_ROUNDS"; return 6; }
  [ "$(sf_kv_get "$bestf" head_sha)" = "$SF_G_HEAD" ] || { sf_gate_fail "the verdict is for $(sf_kv_get "$bestf" head_sha | cut -c1-7), the PR head is $(printf '%s' "$SF_G_HEAD" | cut -c1-7)"; return 6; }
  [ "$(sf_kv_get "$bestf" exit)" = 0 ] || { sf_gate_fail "the relay round did not exit 0"; return 6; }
  [ "$(sf_kv_get "$bestf" context_sha256)" = "$SF_G_PKEY" ] || { sf_gate_fail "the round's reviewers were given a context other than the plan named by Plan-Key"; return 6; }
  [ "$(sf_kv_get "$bestf" all_clean)" = true ] || { sf_gate_fail "the last full-panel round is not all_clean"; return 6; }
  cfg="$(sf_relay_cfg_reviewers)" || { sf_gate_fail "cannot read REVIEWERS from the relay config"; return 6; }
  author="$(sf_kv_get "$bestf" author)"
  case "$author" in agy) author=antigravity;; esac
  want="$(sf_norm_set "$cfg")"; [ -z "$author" ] || want="$(sf_set_without "$want" "$author")"
  have="$(sf_norm_set "$(sf_kv_get "$bestf" configured)")"
  [ -n "$want" ] && [ "$want" = "$have" ] || { sf_gate_fail "the verdict's panel ($have) is not the relay's configured panel without the author ($want)"; return 6; }
  [ "$(sf_norm_set "$(sf_kv_get "$bestf" requested)")" = "$want" ] || { sf_gate_fail "the round did not request the full panel"; return 6; }
  [ "$(sf_norm_set "$(sf_kv_get "$bestf" ran)")" = "$want" ] || { sf_gate_fail "not every seat of the panel ran"; return 6; }
  grep -q '^benched=' "$bestf" || { sf_gate_fail "the verdict file has no benched key"; return 6; }
  [ -z "$(sf_kv_get "$bestf" benched)" ] || { sf_gate_fail "a seat was benched"; return 6; }
  for s in $(printf '%s' "$want" | tr ',' ' '); do
    [ "$(sf_kv_get "$bestf" "seat.$s")" = clean ] || { sf_gate_fail "seat '$s' is not clean in the verdict"; return 6; }
  done
  SF_G_VFILE="$bestf"; SF_G_ROUND="$best"; SF_G_RUNID="$(sf_kv_get "$bestf" run_id)"
  return 0
}

# True when round-1 … round-$SF_G_ROUND all exist for this repo and PR, each with its own pr_round and
# all_clean=true. A missing or mismatched file is false: that PR needs a disposition.
sf_gate_all_rounds_clean() {
  local pr="$1" vdir k=1 f
  case "$SF_G_ROUND" in ''|*[!0-9]*|0) return 1;; esac
  vdir="$(sf_auto_state)/$(printf '%s' "$SF_G_REPO" | tr '/' '_')/pr-$pr"
  while [ "$k" -le "$SF_G_ROUND" ]; do
    f="$vdir/round-$k.verdict"
    [ -f "$f" ] || return 1
    [ "$(sf_kv_get "$f" repo)" = "$SF_G_REPO" ] || return 1
    [ "$(sf_kv_get "$f" pr)" = "$pr" ] || return 1
    [ "$(sf_kv_get "$f" pr_round)" = "$k" ] || return 1
    [ "$(sf_kv_get "$f" all_clean)" = true ] || return 1
    k=$((k + 1))
  done
  return 0
}

# Check 5: no unresolved dispute, and a latest disposition that says so in words.
sf_gate_disputes() {
  local pr="$1" author tmp i=0 login b64 latest="" line rest rc=0 ep
  author="$(gh pr view "$pr" --json author --jq .author.login 2>/dev/null)"
  [ -n "$author" ] || { sf_gate_fail "cannot read the PR author"; return 6; }
  tmp="$(mktemp -d)" || { sf_gate_fail "cannot create a temp dir"; return 6; }
  # gh api --paginate: `gh pr view --json comments` is a single page, and an old unresolved
  # '- DISPUTED:' line outside that page would let check 5 pass. Review comments and review bodies are
  # read too: a dispute written there counts the same. Dispositions come from conversation comments.
  : > "$tmp/list"; : > "$tmp/other"
  if ! gh api --paginate "repos/$SF_G_REPO/issues/$pr/comments" --jq '.[] | "\(.user.login)\t\((.body // "") | @base64)"' > "$tmp/list" 2>/dev/null; then
    rm -rf "$tmp"; sf_gate_fail "cannot read the PR comments"; return 6
  fi
  for ep in "pulls/$pr/comments" "pulls/$pr/reviews"; do
    if ! gh api --paginate "repos/$SF_G_REPO/$ep" --jq '.[] | "\(.user.login)\t\((.body // "") | @base64)"' >> "$tmp/other" 2>/dev/null; then
      rm -rf "$tmp"; sf_gate_fail "cannot read the PR review comments ($ep)"; return 6
    fi
  done
  : > "$tmp/disputed"
  while IFS=$'\t' read -r login b64 || [ -n "$login" ]; do
    [ "$login" = "$author" ] || continue
    i=$((i + 1)); printf '%s' "$b64" | sf_b64d | tr -d '\r' > "$tmp/c$i"
    case "$(head -n 1 "$tmp/c$i")" in Disposition,*) latest="$tmp/c$i";; esac
    grep '^- DISPUTED:' "$tmp/c$i" >> "$tmp/disputed"
  done < "$tmp/list"
  while IFS=$'\t' read -r login b64 || [ -n "$login" ]; do
    [ "$login" = "$author" ] || continue
    printf '%s' "$b64" | sf_b64d | tr -d '\r' | grep '^- DISPUTED:' >> "$tmp/disputed"
  done < "$tmp/other"
  if [ -z "$latest" ]; then
    # A disposition answers a round with findings. When every counted round of this PR was all_clean
    # and the author disputed nothing, there is nothing to answer.
    if [ ! -s "$tmp/disputed" ] && sf_gate_all_rounds_clean "$pr"; then rm -rf "$tmp"; return 0; fi
    rm -rf "$tmp"; sf_gate_fail "no author disposition comment (it must start with 'Disposition,')"; return 6
  fi
  if ! head -n 1 "$latest" | grep -Eqx 'Disposition, round [0-9]+ \(reviewed sha [0-9a-f]{7,40}\):'; then
    rm -rf "$tmp"; sf_gate_fail "the latest disposition's first line is not 'Disposition, round <k> (reviewed sha <sha7>):'"; return 6
  fi
  # The LAST non-empty line, not any line: a quoted 'Disputed findings: none' must not stand in for the
  # real closing line.
  if [ "$(sed '/^[[:space:]]*$/d' "$latest" | tail -n 1)" != 'Disputed findings: none' ]; then
    rm -rf "$tmp"; sf_gate_fail "the latest disposition does not end with the line 'Disputed findings: none'"; return 6
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    rest="${line#- DISPUTED:}"
    grep -qxF -- "- RESOLVED:$rest" "$latest" || { sf_gate_fail "an unresolved '- DISPUTED:' finding:$rest"; rc=6; break; }
  done < "$tmp/disputed"
  rm -rf "$tmp"
  return "$rc"
}

# Check 6, first half: the pre-push hook on both sides of the merge, for every PR. `gh pr merge --merge`
# makes a new commit of the base tip and the PR head, so the head alone is not enough. When both hold a
# 100755 .githooks/pre-push, a three-way merge keeps it with that mode (a content conflict makes the PR
# not MERGEABLE, which check 3 refuses). Reads commits, never the local files or the local config.
sf_gate_hook() {
  local pr="$1" top base side sha line
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || top=""
  [ -n "$top" ] || { sf_gate_fail "merge-gate must run from a checkout of the repository: it reads .githooks/pre-push from the PR head and the base tip"; return 6; }
  base="$(gh pr view "$pr" --json baseRefOid --jq .baseRefOid 2>/dev/null)"
  case "$base" in ''|*[!0-9a-f]*) sf_gate_fail "cannot read the PR's base tip (baseRefOid)"; return 6;; esac
  for side in head base; do
    if [ "$side" = head ]; then sha="$SF_G_HEAD"; else sha="$base"; fi
    git -C "$top" cat-file -e "$sha^{commit}" 2>/dev/null \
      || { sf_gate_fail "the PR $side $(printf '%s' "$sha" | cut -c1-7) is not in this checkout: run git fetch origin (for a PR from a fork: git fetch origin pull/$pr/head)"; return 6; }
    # -C "$top": ls-tree reads the pathspec relative to the current directory.
    line="$(git -C "$top" ls-tree "$sha" -- .githooks/pre-push 2>/dev/null)"
    case "$line" in
      "100755 blob "*) ;;
      *) sf_gate_fail "the PR $side $(printf '%s' "$sha" | cut -c1-7) has no .githooks/pre-push with mode 100755: every repo shipped with ship-feature needs a committed pre-push hook that runs the tests, a linter and a formatter check"; return 6;;
    esac
  done
  SF_G_HOOK="pre-push hook: .githooks/pre-push 100755 at head $(printf '%s' "$SF_G_HEAD" | cut -c1-7) and base $(printf '%s' "$base" | cut -c1-7)"
  return 0
}

# Check 6: the hook (above), then CI on the verdict SHA. SUCCESS / NEUTRAL only; empty needs a file a
# human created. SF_G_HOOKFAIL tells the check-8 re-read that the hook, not CI, failed.
sf_gate_ci() {
  local pr="$1" rows st co sa
  SF_G_HOOKFAIL=""
  sf_gate_hook "$pr" || { SF_G_HOOKFAIL=1; return 6; }
  rows="$(gh pr view "$pr" --json statusCheckRollup --jq '.statusCheckRollup[]? | "\(.status // "-")|\(.conclusion // "-")|\(.state // "-")"' 2>/dev/null)" || { sf_gate_fail "cannot read the CI checks"; return 6; }
  if [ -z "$rows" ]; then
    if grep -qxF -- "$SF_G_REPO" "$(sf_auto_cfg_dir)/allow-no-ci" 2>/dev/null; then SF_G_CI="(none: allowed by the allow-no-ci file)"$'\n'"$SF_G_HOOK"; return 0; fi
    sf_gate_fail "the PR reports no CI checks (a human can allow this repo in $(sf_auto_cfg_dir)/allow-no-ci)"; return 6
  fi
  while IFS='|' read -r st co sa; do
    if [ "$st" != "-" ]; then
      { [ "$st" = COMPLETED ] && { [ "$co" = SUCCESS ] || [ "$co" = NEUTRAL ]; }; } || { sf_gate_fail "a check is not green (status $st, conclusion $co)"; return 6; }
    else
      [ "$sa" = SUCCESS ] || { sf_gate_fail "a check is not green (state $sa)"; return 6; }
    fi
  done <<EOF
$rows
EOF
  SF_G_CI="$rows"$'\n'"$SF_G_HOOK"
  return 0
}

# Check 7: stop on sensitive files (bash case patterns; `*` also matches `/`).
sf_gate_sensitive() {
  local pr="$1" rows files names f pat pf pats match=0 n want new old
  # The PR files API, not `gh pr diff --name-only`: a rename lists only its NEW path there, so a file
  # moved out of a protected path would pass. Every row gives the path and, for a rename, the previous
  # path; BOTH are matched. Paginated, and the count is checked against the PR's changedFiles, so a
  # truncated list fails closed.
  rows="$(gh api --paginate "repos/$SF_G_REPO/pulls/$pr/files" --jq '.[] | "\(.filename)\t\(.previous_filename // "")"' 2>/dev/null)" \
    || { sf_gate_fail "cannot read the PR file list"; return 6; }
  rows="$(printf '%s\n' "$rows" | tr -d '\r' | sed '/^$/d')"
  [ -n "$rows" ] || { sf_gate_fail "the PR file list is empty"; return 6; }
  n="$(printf '%s\n' "$rows" | wc -l | tr -d ' ')"
  want="$(gh pr view "$pr" --json changedFiles --jq .changedFiles 2>/dev/null)"
  [ "$want" = "$n" ] || { sf_gate_fail "the PR file list is incomplete ($n of ${want:-unknown} changed files read)"; return 6; }
  names=""; files=""
  while IFS=$'\t' read -r new old || [ -n "$new" ]; do
    [ -n "$new" ] || continue
    names="$names$new"$'\n'
    if [ -n "$old" ]; then names="$names$old"$'\n'; files="$files$old -> $new"$'\n'; else files="$files$new"$'\n'; fi
  done <<EOF
$rows
EOF
  files="${files%$'\n'}"
  pf="$(sf_auto_cfg_dir)/sensitive-paths"
  # A file that exists but cannot be read must not become an empty list (which allows every path).
  if [ -e "$pf" ]; then
    pats="$(cat "$pf" 2>/dev/null)" || { sf_gate_fail "cannot read $pf"; return 6; }
    pats="$(printf '%s\n' "$pats" | tr -d '\r')"   # a CRLF file must not turn every pattern into one that matches nothing
    # A file with no active pattern would allow every path; that is never what an empty file means.
    printf '%s\n' "$pats" | grep -Eqv '^[[:space:]]*(#|$)' || { sf_gate_fail "$pf has no active pattern (remove it to use the defaults)"; return 6; }
  else
    pats="$(sf_default_sensitive)"
  fi
  # The gate's entry points are always sensitive, also with a custom file: the agent never changes its
  # own gate alone. Added only after the custom file passed the check above, so an empty or
  # comments-only file still fails closed.
  for pat in '.githooks/*' 'bin/ci' 'config/ci.rb'; do
    printf '%s\n' "$pats" | grep -qxF -- "$pat" || pats="$pats"$'\n'"$pat"
  done
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    while IFS= read -r pat; do
      case "$pat" in ''|\#*) continue;; esac
      # shellcheck disable=SC2254
      case "$f" in $pat) sf_gate_fail "the PR touches a sensitive path ($f matches '$pat') — a human merges this one"; match=1;; esac
    done <<EOF
$pats
EOF
  done <<EOF
$names
EOF
  [ "$match" = 0 ] || return 6
  SF_G_FILES="$files"
  return 0
}

cmd_merge_gate() {
  local pr="" auto=0 do_merge=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --autonomous) auto=1; shift;;
      --merge) do_merge=1; shift;;
      -h|--help) echo "usage: ship-feature merge-gate <pr> --autonomous [--merge]   (needs SHIP_FEATURE_AUTONOMOUS=1; without --merge it only reports)"; return 0;;
      -*) die "unknown arg: $1";;
      *) [ -z "$pr" ] || die "only one PR number may be given."; pr="$1"; shift;;
    esac
  done
  case "$pr" in ''|*[!0-9]*) die "merge-gate needs a PR number.";; esac
  sf_auto_guard "$auto" || return 7
  command -v gh >/dev/null 2>&1 || { sf_gate_fail "gh not found on PATH"; return 6; }
  load_config
  SF_G_REPO=""; SF_G_HEAD=""; SF_G_VFILE=""; SF_G_ROUND=""; SF_G_CONS=""; SF_G_CI=""; SF_G_FILES=""; SF_G_PKEY=""; SF_G_RUNID=""; SF_G_HOOK=""; SF_G_HOOKFAIL=""
  sf_gate_plan "$pr"      || return 6
  sf_gate_pr "$pr"        || return 6
  sf_gate_verdict "$pr"   || return 6
  sf_gate_disputes "$pr"  || return 6
  sf_gate_ci "$pr"        || return 6
  sf_gate_sensitive "$pr" || return 6
  if [ "$do_merge" != 1 ]; then
    echo "✔ merge-gate: every check passes for $SF_G_REPO#$pr at $(printf '%s' "$SF_G_HEAD" | cut -c1-7) (round $SF_G_ROUND). Not merging: --merge was not given." >&2
    return 0
  fi
  # Merge, under the same PR lock that relay --autonomous takes, so no round can finish between the
  # last read and the merge call.
  local adir rc=0
  adir="$(sf_auto_state)/$(printf '%s' "$SF_G_REPO" | tr '/' '_')/pr-$pr"
  sf_mkdirp "$adir" 2>/dev/null || { sf_gate_fail "cannot create $adir"; return 6; }
  sf_lock "$adir" || { sf_gate_fail "an autonomous round (or another merge-gate) holds the lock for $SF_G_REPO#$pr ($adir.lock); not merging"; return 6; }
  sf_gate_merge "$pr" "$adir"; rc=$?
  sf_unlock "$adir"
  return "$rc"
}

# The audit comment's text. $1 = how many file names to list (empty: all of them). The total is
# always stated, and a shortened list says so and where the full one is.
sf_audit_text() {
  local limit="$1" mc="$2" afile="$3" total
  total="$(printf '%s\n' "$SF_G_FILES" | sed '/^$/d' | wc -l | tr -d ' ')"
  printf 'Autonomous merge (ship-feature merge-gate)\n\n'
  printf 'head_sha=%s\nmerge_commit=%s\nround=%s\nautonomous_env=1\n' "$SF_G_HEAD" "${mc:-unknown}" "$SF_G_ROUND"
  printf 'plan_degraded_seats=%s\n\nci_checks (status|conclusion|state):\n' "$(sf_kv_get "$SF_G_CONS" degraded)"
  printf '%s\n' "$SF_G_CI" | sed 's/^/    /'
  printf '\nfiles_checked (%s):\n' "$total"
  if [ -z "$limit" ] || [ "$total" -le "$limit" ]; then
    printf '%s\n' "$SF_G_FILES" | sed '/^$/d; s/^/    /'
  else
    printf '%s\n' "$SF_G_FILES" | sed '/^$/d' | head -n "$limit" | sed 's/^/    /'
    printf '    ... %s of %s files listed here; the full list is in %s\n' "$limit" "$total" "${afile:-the text printed by merge-gate}"
  fi
  printf '\nverdict file:\n'
  sed 's/^/    /' "$SF_G_VFILE"
}

sf_gate_merge() {
  local pr="$1" adir="$2" head2 mc audit full afile vfile1="$SF_G_VFILE" run1="$SF_G_RUNID"
  # Re-read the head, the highest verdict (compared with what check 4 saw), and CI; recheck the kill
  # switch; then ONE merge call pinned to the verdict SHA.
  head2="$(gh pr view "$pr" --json headRefOid --jq .headRefOid 2>/dev/null)"
  [ "$head2" = "$SF_G_HEAD" ] || { sf_gate_fail "the PR head moved during the checks ($(printf '%s' "$SF_G_HEAD" | cut -c1-7) -> $(printf '%s' "$head2" | cut -c1-7))"; return 6; }
  sf_gate_verdict "$pr" || { sf_gate_fail "the verdict changed after the checks; not merging"; return 6; }
  [ "$SF_G_VFILE" = "$vfile1" ] && [ "$SF_G_RUNID" = "$run1" ] \
    || { sf_gate_fail "a newer round was recorded after the checks; not merging"; return 6; }
  # Disputes again: a '- DISPUTED:' line posted after check 5 must stop the merge too.
  sf_gate_disputes "$pr" || { sf_gate_fail "a dispute appeared after the checks; not merging"; return 6; }
  # CI again, on the same SHA: a check can be re-run or turn red after the first read. The hook is read
  # again too, on the same head and the base tip as it is now; a hook failure keeps its own reason.
  sf_gate_ci "$pr" || { [ "$SF_G_HOOKFAIL" = 1 ] || sf_gate_fail "CI changed after the checks; not merging"; return 6; }
  gh pr merge --help 2>&1 | grep -q -- '--match-head-commit' || { sf_gate_fail "this gh has no 'pr merge --match-head-commit'; update gh"; return 6; }
  sf_auto_guard 1 || return 7
  gh pr merge "$pr" --merge --match-head-commit "$SF_G_HEAD" || { sf_gate_fail "the merge call failed; nothing was retried"; return 6; }
  mc="$(gh pr view "$pr" --json mergeCommit --jq .mergeCommit.oid 2>/dev/null)"
  # The audit text is built in memory first: the merge has happened, so a state directory that cannot
  # be written must not lose it. audit.txt holds the full text; the comment holds it too unless it would
  # pass GitHub's comment size limit, in which case the file list is shortened and says so.
  afile="$adir/audit.txt"
  full="$(sf_audit_text "" "$mc" "$afile")"
  printf '%s\n' "$full" > "$afile" 2>/dev/null || { echo "  ! cannot write $afile; the audit text is posted and printed instead" >&2; afile=""; full="$(sf_audit_text "" "$mc" "")"; }
  audit="$full"
  if [ "${#full}" -gt "$SF_AUDIT_MAX_BYTES" ]; then
    # Shorten the list until the comment fits; at 0 names the text is a few hundred bytes.
    local lim=200
    audit="$(sf_audit_text "$lim" "$mc" "$afile")"
    while [ "${#audit}" -gt "$SF_AUDIT_MAX_BYTES" ] && [ "$lim" -gt 0 ]; do
      lim=$((lim / 2)); audit="$(sf_audit_text "$lim" "$mc" "$afile")"
    done
    # No file to point at: the full text goes to stdout, so the list is never lost.
    [ -n "$afile" ] || printf '%s\n' "$full"
  fi
  echo "✔ merge-gate: merged $SF_G_REPO#$pr as ${mc:-unknown}" >&2
  if ! printf '%s\n' "$audit" | gh pr comment "$pr" --body-file - >/dev/null 2>&1; then
    echo "✖ merged, audit comment NOT posted — post it. Text${afile:+ (also in $afile)}:" >&2
    printf '%s\n' "$audit"
    return 8
  fi
  [ -n "$mc" ] && printf '%s\n' "$mc"
  return 0
}

main() {
  local sub="${1:-help}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    preflight)   cmd_preflight "$@" ;;
    relay)       cmd_relay "$@" ;;
    plan-review) cmd_plan_review "$@" ;;
    plan-consensus) cmd_plan_consensus "$@" ;;
    merge-gate)  cmd_merge_gate "$@" ;;
    # Print the whole header comment block — from line 2 to the first line that is not a
    # comment. A hardcoded end line silently truncates help the moment anyone documents a new
    # flag up there, which is exactly how this broke once; the shebang is the only line skipped.
    help|-h|--help) awk 'NR>1 { if ($0 !~ /^#/) exit; print }' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command: $sub (try: ship-feature help)" ;;
  esac
}
main "$@"
